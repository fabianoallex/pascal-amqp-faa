<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="pascal_amqp_faa"/>
    <Author Value="Fabiano Arndt"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <IncludeFiles Value="..\src"/>
        <OtherUnitFiles Value="..\src"/>
        <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Description Value="AMQP 0-9-1 (RabbitMQ) client for FPC/Lazarus and Delphi, written from scratch. Publish/consume with manual ack, publisher confirms, heartbeat, automatic reconnection with topology recovery, and TLS (SChannel on Windows; OpenSSL opt-in via -dAMQP_OPENSSL on any platform)."/>
    <License Value="MIT"/>
    <Version Minor="6"/>
    <Files>
      <Item>
        <Filename Value="..\src\amqp.inc"/>
        <Type Value="Include"/>
      </Item>
      <Item>
        <Filename Value="..\src\AMQP.Protocol.pas"/>
        <UnitName Value="AMQP.Protocol"/>
      </Item>
      <Item>
        <Filename Value="..\src\AMQP.Wire.pas"/>
        <UnitName Value="AMQP.Wire"/>
      </Item>
      <Item>
        <Filename Value="..\src\AMQP.Frame.pas"/>
        <UnitName Value="AMQP.Frame"/>
      </Item>
      <Item>
        <Filename Value="..\src\AMQP.Method.pas"/>
        <UnitName Value="AMQP.Method"/>
      </Item>
      <Item>
        <Filename Value="..\src\AMQP.Connection.Methods.pas"/>
        <UnitName Value="AMQP.Connection.Methods"/>
      </Item>
      <Item>
        <Filename Value="..\src\AMQP.Channel.Methods.pas"/>
        <UnitName Value="AMQP.Channel.Methods"/>
      </Item>
      <Item>
        <Filename Value="..\src\AMQP.Exchange.Methods.pas"/>
        <UnitName Value="AMQP.Exchange.Methods"/>
      </Item>
      <Item>
        <Filename Value="..\src\AMQP.Queue.Methods.pas"/>
        <UnitName Value="AMQP.Queue.Methods"/>
      </Item>
      <Item>
        <Filename Value="..\src\AMQP.Basic.Methods.pas"/>
        <UnitName Value="AMQP.Basic.Methods"/>
      </Item>
      <Item>
        <Filename Value="..\src\AMQP.Threading.pas"/>
        <UnitName Value="AMQP.Threading"/>
      </Item>
      <Item>
        <Filename Value="..\src\AMQP.Transport.pas"/>
        <UnitName Value="AMQP.Transport"/>
      </Item>
      <Item>
        <Filename Value="..\src\AMQP.Transport.Tls.pas"/>
        <UnitName Value="AMQP.Transport.Tls"/>
      </Item>
      <Item>
        <Filename Value="..\src\AMQP.Transport.OpenSSL.pas"/>
        <UnitName Value="AMQP.Transport.OpenSSL"/>
      </Item>
      <Item>
        <Filename Value="..\src\AMQP.Tracing.pas"/>
        <UnitName Value="AMQP.Tracing"/>
      </Item>
      <Item>
        <Filename Value="..\src\AMQP.Connection.pas"/>
        <UnitName Value="AMQP.Connection"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <!-- By name only, no DefaultFilename: the application provides the single
           copy of pascal-common-faa (a registered pascal_common_faa.lpk).
           A DefaultFilename pointing at external/ would make Lazarus fall back to
           this library's private copy - the diamond pascal-common-faa forbids. The
           test/sample .lpi files point at external/ with Prefer="True". -->
      <Item>
        <PackageName Value="pascal_common_faa"/>
        <MinVersion Major="1" Minor="27" Valid="True"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
