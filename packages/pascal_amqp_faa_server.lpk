<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="pascal_amqp_faa_server"/>
    <Author Value="Fabiano Arndt"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <IncludeFiles Value="..\src"/>
        <OtherUnitFiles Value="..\src\server"/>
        <UnitOutputDirectory Value="lib\srv-$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Description Value="Broker AMQP 0-9-1 embutivel para FPC/Lazarus e Delphi (sub-modulo server do pascal-amqp-faa). Depende do pacote cliente pascal_amqp_faa: reusa o codec de wire, framing, field-tables e o transporte. Fase 1: handshake completo, canais, decodificacao de todo metodo cliente->servidor, heartbeat, close com modelo de erro; sem engine de roteamento ainda."/>
    <License Value="MIT"/>
    <Version Minor="1"/>
    <Files>
      <Item>
        <Filename Value="..\src\server\AMQP.Server.Auth.pas"/>
        <UnitName Value="AMQP.Server.Auth"/>
      </Item>
      <Item>
        <Filename Value="..\src\server\AMQP.Server.Types.pas"/>
        <UnitName Value="AMQP.Server.Types"/>
      </Item>
      <Item>
        <Filename Value="..\src\server\AMQP.Server.Channel.pas"/>
        <UnitName Value="AMQP.Server.Channel"/>
      </Item>
      <Item>
        <Filename Value="..\src\server\AMQP.Server.FrameIO.pas"/>
        <UnitName Value="AMQP.Server.FrameIO"/>
      </Item>
      <Item>
        <Filename Value="..\src\server\AMQP.Server.Connection.pas"/>
        <UnitName Value="AMQP.Server.Connection"/>
      </Item>
      <Item>
        <Filename Value="..\src\server\AMQP.Server.Broker.pas"/>
        <UnitName Value="AMQP.Server.Broker"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="pascal_amqp_faa"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
