# build outputs
build/
lib/
backup/
*.exe
*.o
*.a
*.ppu
*.rsj
*.compiled
*.dcu
Win32/
Win64/
linux/

# .res resource generated by the IDE (default icon) - regenerable; some come out at
# hundreds of KB in VCL/LCL apps; SmokeTest.res, already versioned, stays as is
*.res

# ELF binaries (no extension) produced by lazbuild on Linux in the project directory
samples/AuthorizerSim/AuthorizerSim
samples/AuthorizerSimVcl/AuthorizerSimVcl
samples/BackOffice/BackOffice
samples/BackOfficeVcl/BackOfficeVcl
samples/ReliablePublisherVcl/ReliablePublisherVcl
samples/StatusQueryVcl/StatusQueryVcl
samples/RetryDlqVcl/RetryDlqVcl
samples/TopicEventsVcl/TopicEventsVcl
samples/SmokeTest/SmokeTest
tests/Unit/fpc/AMQPUnitTestsFpc
tests/Integration/fpc/AMQPIntegrationTestsFpc
tests/Server/fpc/AMQPServerTestsFpc
tests/Outbox/fpc/AMQPOutboxTestsFpc

# sqlite.org sqlite3.dll copied next to the outbox runner (FPC on Windows)
tests/Outbox/fpc/sqlite3.dll

# lazbuild package-links cache (machine-specific)
/packagefiles.xml

# dev broker certificates (generate locally; see docker/certs/README.md)
docker/certs/*.crt
docker/certs/*.key

# session/IDE files
*.lps
*.local
*.identcache
*.stat
__history/
__recovery/
