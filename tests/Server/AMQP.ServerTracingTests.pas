unit AMQP.ServerTracingTests;

{ End-to-end client spans (phase D of pascal-api-infra-faa's observability
  design; see docs/tracing.md): the REAL CLIENT against the embedded
  broker, with pascal-common-faa's tracer on and an exporter that only
  keeps the spans.

  The broker does NOT open a span (the user's decision, 2026-10-12): it passes the
  content header through byte for byte (D1), so the traceparent crosses intact --
  including on dead-letter, which rewrites the header (x-death) and must keep
  the rest.

  The tracer is process-global state: each test turns it on in SetUp and off
  in TearDown, with AAutoFlush = False (the test exports with FlushNow; no
  export thread). The 'process' span ends on a pool thread AFTER the
  callback returns, so the test waits for the span (EsperaSpan), never for the
  callback.

  DUnitX master in FPCUnit's dialect (TAssert.*); the FPCUnit mirror in
  fpc\ is generated by tools/gen_fpc_mirror.py. }


interface

uses
  DUnitX.TestFramework,
  AMQP.DUnitXCompat,
  SysUtils,
  Classes,
  Rtti,
  SyncObjs,
  Generics.Collections,
  AMQP.Wire,
  AMQP.Queue.Methods,
  AMQP.Basic.Methods,
  PascalCommon.Threading,
  PascalCommon.Tracing,
  AMQP.Connection,
  AMQP.Tracing,
  AMQP.Server.Broker;

type
  { Exporter that only keeps: the spans arrive in the order they ended. }
  TSpanCollector = class(TInterfacedObject, IPcSpanExporter)
  private
    FLock: TCriticalSection;
    FSpans: TList<TPcSpanData>;
  public
    constructor Create;
    destructor Destroy; override;
    function ExportSpans(const ASpans: TPcSpanDataArray; out AError: string): Boolean;
    function Count: Integer;
    /// The spans with that name, in the order they ended.
    function WithName(const AName: string): TPcSpanDataArray;
  end;

  [TestFixture]
  TTracingTests = class
  private
    FBroker: TAMQPServer;
    FCollector: TSpanCollector;
    FCollectorRef: IPcSpanExporter;
    FLock: TCriticalSection;
    FSeenTraceParent: string;
    FReceived: Integer;
    FForwardTo: string;
    // what OnConsumerError saw as the current span ('' = none)
    FTraceInHandler: string;
    FSpanInHandler: string;
    FHandlerCalled: Integer;
    function Params: TAMQPConnectionParams;
    procedure HandleDelivery(AChannel: TAMQPChannel; const ADelivery: TAMQPDelivery);
    procedure HandleFailure(AChannel: TAMQPChannel; const ADelivery: TAMQPDelivery;
      AError: Exception; var AAction: TAMQPConsumerErrorAction);
    /// Exports and waits for ACount spans with that name.
    function WaitSpans(const AName: string; ACount, ATimeoutMs: Integer): Boolean;
    /// The AIndex-th span with that name (fails the test if there is none).
    function Span(const AName: string; AIndex: Integer = 0): TPcSpanData;
    /// The span with that name and that attribute value (fails if there is none).
    function SpanWith(const AName, AKey, AValue: string): TPcSpanData;
    function SeenTraceParent: string;
  public
    [Setup] procedure SetUp;
    [TearDown] procedure TearDown;
    [Test] procedure PublishAndProcess_InTheCurrentSpanTrace;
    [Test] procedure Consumer_SeesThePublishTraceParent;
    [Test] procedure ApplicationTraceParent_Wins;
    [Test] procedure PublishInsideCallback_IsChildOfProcess;
    [Test] procedure RaisingCallback_ProcessWithError;
    [Test] procedure OnConsumerError_RunsInsideProcess;
    [Test] procedure Get_ReceiveSpanIsChildOfCurrent;
    [Test] procedure DeadLetter_PreservesTheTraceParent;
    [Test] procedure GeneratedQueue_TemporaryNameInSpan;
    [Test] procedure TracerOff_DoesNotInjectHeader;
  end;

implementation

const
  APP_TRACEPARENT = '00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01';
  RAISING_BODY = 'raise';

{ --- helpers --- }

function NewBroker: TAMQPServer;
begin
  Result := TAMQPServer.Create;
  Result.BindAddress := '127.0.0.1';
  Result.Port := 0;
  Result.Start;
end;

function Attr(const ASpan: TPcSpanData; const AKey: string): string;
var
  I: Integer;
begin
  Result := '';
  for I := 0 to High(ASpan.Attributes) do
    if ASpan.Attributes[I].Key = AKey then
    begin
      case ASpan.Attributes[I].ValueType of
        satString: Result := ASpan.Attributes[I].StringValue;
        satInt: Result := IntToStr(ASpan.Attributes[I].IntValue);
        // BoolToStr with the texts only exists in FPC.
        satBool:
          if ASpan.Attributes[I].BoolValue then
            Result := 'true'
          else
            Result := 'false';
      else
        Result := FloatToStr(ASpan.Attributes[I].DoubleValue);
      end;
      Exit;
    end;
end;

function TraceParentOf(const ASpan: TPcSpanData): string;
begin
  Result := '00-' + ASpan.TraceId + '-' + ASpan.SpanId + '-01';
end;

procedure FreeHeaders(const AResult: TAMQPGetResult);
begin
  if bpHeaders in AResult.Properties.Flags then
    AResult.Properties.Headers.Free;
end;

{ --- TSpanCollector --- }

constructor TSpanCollector.Create;
begin
  inherited Create;
  FLock := TCriticalSection.Create;
  FSpans := TList<TPcSpanData>.Create;
end;

destructor TSpanCollector.Destroy;
begin
  FSpans.Free;
  FLock.Free;
  inherited;
end;

function TSpanCollector.ExportSpans(const ASpans: TPcSpanDataArray;
  out AError: string): Boolean;
var
  I: Integer;
begin
  AError := '';
  FLock.Enter;
  try
    for I := 0 to High(ASpans) do
      FSpans.Add(ASpans[I]);
  finally
    FLock.Leave;
  end;
  Result := True;
end;

function TSpanCollector.Count: Integer;
begin
  FLock.Enter;
  try
    Result := FSpans.Count;
  finally
    FLock.Leave;
  end;
end;

function TSpanCollector.WithName(const AName: string): TPcSpanDataArray;
var
  I: Integer;
begin
  Result := nil;
  FLock.Enter;
  try
    for I := 0 to FSpans.Count - 1 do
      if FSpans[I].Name = AName then
      begin
        SetLength(Result, Length(Result) + 1);
        Result[High(Result)] := FSpans[I];
      end;
  finally
    FLock.Leave;
  end;
end;

{ --- TTracingTests --- }

procedure TTracingTests.SetUp;
begin
  FBroker := NewBroker;
  FLock := TCriticalSection.Create;
  FSeenTraceParent := '';
  FReceived := 0;
  FForwardTo := '';
  FTraceInHandler := '';
  FSpanInHandler := '';
  FHandlerCalled := 0;
  FCollector := TSpanCollector.Create;
  FCollectorRef := FCollector;
  TPcTracing.Start(TPcTracingOptions.Default('amqp-tests', '0'), FCollectorRef, False);
end;

procedure TTracingTests.TearDown;
begin
  TPcTracing.Shutdown;
  FBroker.Free;
  FCollectorRef := nil;
  FLock.Free;
end;

function TTracingTests.Params: TAMQPConnectionParams;
begin
  Result := TAMQPConnectionParams.Localhost;
  Result.Host := '127.0.0.1';
  Result.Port := FBroker.Port;
end;

procedure TTracingTests.HandleDelivery(AChannel: TAMQPChannel;
  const ADelivery: TAMQPDelivery);
var
  LParent, LState: string;
begin
  AmqpTraceParentOf(ADelivery.Properties, LParent, LState);
  FLock.Enter;
  try
    FSeenTraceParent := LParent;
    Inc(FReceived);
  finally
    FLock.Leave;
  end;
  // Forwards what came from another queue (what reaches the destination one stops here).
  if (FForwardTo <> '') and (ADelivery.RoutingKey <> FForwardTo) then
    AChannel.PublishText('', FForwardTo, 'forwarded');
  if ADelivery.BodyAsText = RAISING_BODY then
    raise Exception.Create('failed on purpose');
end;

procedure TTracingTests.HandleFailure(AChannel: TAMQPChannel;
  const ADelivery: TAMQPDelivery; AError: Exception;
  var AAction: TAMQPConsumerErrorAction);
var
  LCurrent: IPcSpan;
begin
  // What an application log would see here: the thread's current span.
  LCurrent := TPcTracing.Current;
  FLock.Enter;
  try
    if LCurrent <> nil then
    begin
      FTraceInHandler := LCurrent.TraceId;
      FSpanInHandler := LCurrent.SpanId;
    end;
  finally
    FLock.Leave;
  end;
  PcAtomicInc(FHandlerCalled);
end;

function TTracingTests.SeenTraceParent: string;
begin
  FLock.Enter;
  try
    Result := FSeenTraceParent;
  finally
    FLock.Leave;
  end;
end;

function TTracingTests.WaitSpans(const AName: string; ACount,
  ATimeoutMs: Integer): Boolean;
var
  LDeadline: UInt64;
begin
  LDeadline := PcTickMs + UInt64(ATimeoutMs);
  repeat
    TPcTracing.FlushNow;
    Result := Length(FCollector.WithName(AName)) >= ACount;
    if Result or (PcTickMs >= LDeadline) then
      Exit;
    Sleep(10);
  until False;
end;

function TTracingTests.Span(const AName: string; AIndex: Integer): TPcSpanData;
var
  LSpans: TPcSpanDataArray;
begin
  LSpans := FCollector.WithName(AName);
  if AIndex > High(LSpans) then
    TAssert.Fail('missing span ' + AName + ' #' + IntToStr(AIndex));
  Result := LSpans[AIndex];
end;

function TTracingTests.SpanWith(const AName, AKey, AValue: string): TPcSpanData;
var
  LSpans: TPcSpanDataArray;
  I: Integer;
begin
  LSpans := FCollector.WithName(AName);
  for I := 0 to High(LSpans) do
    if Attr(LSpans[I], AKey) = AValue then
      Exit(LSpans[I]);
  TAssert.Fail('missing span ' + AName + ' with ' + AKey + '=' + AValue);
end;

procedure TTracingTests.PublishAndProcess_InTheCurrentSpanTrace;
var
  LConn: TAMQPConnection;
  LCh: TAMQPChannel;
  LParent: IPcSpan;
  LTraceId, LParentId: string;
  LPub, LProc: TPcSpanData;
begin
  LConn := TAMQPConnection.Create(Params);
  try
    LConn.Open;
    LCh := LConn.CreateChannel;
    LCh.DeclareQueue(TAMQPQueueDeclare.Create('q.trace', False));
    LCh.Consume('q.trace', HandleDelivery, True);

    LParent := TPcTracing.StartSpan('GET /orders', skServer);
    LTraceId := LParent.TraceId;
    LParentId := LParent.SpanId;
    try
      LCh.PublishText('', 'q.trace', 'oi');
    finally
      LParent.Finish;
      LParent := nil;
    end;

    TAssert.AssertTrue('the process span ended', WaitSpans('process q.trace', 1, 5000));
    LPub := Span('publish amq.default');
    LProc := Span('process q.trace');

    TAssert.AssertEquals('publish in the parent trace', LTraceId, LPub.TraceId);
    TAssert.AssertEquals('publish child of the parent', LParentId, LPub.ParentSpanId);
    TAssert.AssertTrue('publish is producer', LPub.Kind = skProducer);
    TAssert.AssertEquals('process in the same trace', LTraceId, LProc.TraceId);
    TAssert.AssertEquals('process child of the publish', LPub.SpanId, LProc.ParentSpanId);
    TAssert.AssertTrue('process is consumer', LProc.Kind = skConsumer);

    TAssert.AssertEquals('system', 'rabbitmq', Attr(LPub, 'messaging.system'));
    TAssert.AssertEquals('publish operation', 'send', Attr(LPub, 'messaging.operation.type'));
    TAssert.AssertEquals('routing key', 'q.trace',
      Attr(LPub, 'messaging.rabbitmq.destination.routing_key'));
    TAssert.AssertEquals('size', '2', Attr(LPub, 'messaging.message.body.size'));
    TAssert.AssertEquals('port', IntToStr(FBroker.Port), Attr(LPub, 'server.port'));
    TAssert.AssertEquals('process operation', 'process', Attr(LProc, 'messaging.operation.type'));
    TAssert.AssertEquals('queue', 'q.trace', Attr(LProc, 'messaging.destination.name'));
    TAssert.AssertEquals('delivery tag', '1', Attr(LProc, 'messaging.rabbitmq.message.delivery_tag'));
    TAssert.AssertTrue('no error', LProc.Status <> ssError);
  finally
    LConn.Free;
  end;
end;

procedure TTracingTests.Consumer_SeesThePublishTraceParent;
var
  LConn: TAMQPConnection;
  LCh: TAMQPChannel;
begin
  LConn := TAMQPConnection.Create(Params);
  try
    LConn.Open;
    LCh := LConn.CreateChannel;
    LCh.DeclareQueue(TAMQPQueueDeclare.Create('q.seen', False));
    LCh.Consume('q.seen', HandleDelivery, True);
    LCh.PublishText('', 'q.seen', 'oi');

    TAssert.AssertTrue('the process span ended', WaitSpans('process q.seen', 1, 5000));
    TAssert.AssertEquals('the header carries the publish context',
      TraceParentOf(Span('publish amq.default')), SeenTraceParent);
  finally
    LConn.Free;
  end;
end;

procedure TTracingTests.ApplicationTraceParent_Wins;
var
  LConn: TAMQPConnection;
  LCh: TAMQPChannel;
  LProps: TAMQPBasicProperties;
  LTable: TAMQPFieldTable;
  LValue: TValue;
  LProc: TPcSpanData;
begin
  LConn := TAMQPConnection.Create(Params);
  try
    LConn.Open;
    LCh := LConn.CreateChannel;
    LCh.DeclareQueue(TAMQPQueueDeclare.Create('q.app', False));
    LCh.Consume('q.app', HandleDelivery, True);

    LTable := TAMQPFieldTable.Create;
    try
      LValue := TValue.From<string>(APP_TRACEPARENT);
      LTable.Put('traceparent', LValue);
      LProps := TAMQPBasicProperties.Empty;
      LProps.SetHeaders(LTable);
      LCh.Publish('', 'q.app', AmqpUtf8Encode('oi'), LProps);
      TAssert.AssertEquals('the caller table did not change', 1, Integer(LTable.Count));
    finally
      LTable.Free;
    end;

    TAssert.AssertTrue('the process span ended', WaitSpans('process q.app', 1, 5000));
    LProc := Span('process q.app');
    TAssert.AssertEquals('the application one arrived', APP_TRACEPARENT, SeenTraceParent);
    TAssert.AssertEquals('process in the application trace',
      '4bf92f3577b34da6a3ce929d0e0e4736', LProc.TraceId);
    TAssert.AssertEquals('process child of the application span', '00f067aa0ba902b7',
      LProc.ParentSpanId);
  finally
    LConn.Free;
  end;
end;

procedure TTracingTests.PublishInsideCallback_IsChildOfProcess;
var
  LConn: TAMQPConnection;
  LCh: TAMQPChannel;
  LProcA, LProcB, LPub2: TPcSpanData;
begin
  LConn := TAMQPConnection.Create(Params);
  try
    LConn.Open;
    LCh := LConn.CreateChannel;
    LCh.DeclareQueue(TAMQPQueueDeclare.Create('q.a', False));
    LCh.DeclareQueue(TAMQPQueueDeclare.Create('q.b', False));
    FForwardTo := 'q.b';
    LCh.Consume('q.a', HandleDelivery, True);
    LCh.Consume('q.b', HandleDelivery, True);
    LCh.PublishText('', 'q.a', 'oi');

    TAssert.AssertTrue('the forwarded process span ended', WaitSpans('process q.b', 1, 5000));
    LProcA := Span('process q.a');
    LPub2 := SpanWith('publish amq.default',
      'messaging.rabbitmq.destination.routing_key', 'q.b');
    LProcB := Span('process q.b');
    TAssert.AssertEquals('publish child of the process', LProcA.SpanId, LPub2.ParentSpanId);
    TAssert.AssertEquals('forwarded process is its child', LPub2.SpanId, LProcB.ParentSpanId);
    TAssert.AssertEquals('a single trace', LProcA.TraceId, LProcB.TraceId);
  finally
    FForwardTo := '';
    LConn.Free;
  end;
end;

procedure TTracingTests.RaisingCallback_ProcessWithError;
var
  LConn: TAMQPConnection;
  LCh: TAMQPChannel;
  LProc: TPcSpanData;
begin
  LConn := TAMQPConnection.Create(Params);
  try
    LConn.Open;
    LCh := LConn.CreateChannel;
    LCh.DeclareQueue(TAMQPQueueDeclare.Create('q.error', False));
    LCh.Consume('q.error', HandleDelivery, True);
    LCh.PublishText('', 'q.error', RAISING_BODY);

    TAssert.AssertTrue('the process span ended', WaitSpans('process q.error', 1, 5000));
    LProc := Span('process q.error');
    TAssert.AssertTrue('error status', LProc.Status = ssError);
    TAssert.AssertEquals('message', 'failed on purpose', LProc.StatusMessage);
    TAssert.AssertEquals('class', 'Exception', Attr(LProc, 'error.type'));
  finally
    LConn.Free;
  end;
end;

procedure TTracingTests.OnConsumerError_RunsInsideProcess;
var
  LConn: TAMQPConnection;
  LCh: TAMQPChannel;
  LProc: TPcSpanData;
begin
  // The error handler logs with the message's trace id: 'process' stays
  // current during it and only ends afterwards, still marked with the error.
  LConn := TAMQPConnection.Create(Params);
  try
    LConn.Open;
    LCh := LConn.CreateChannel;
    LCh.OnConsumerError := HandleFailure;
    LCh.DeclareQueue(TAMQPQueueDeclare.Create('q.handler', False));
    LCh.Consume('q.handler', HandleDelivery, True);
    LCh.PublishText('', 'q.handler', RAISING_BODY);

    TAssert.AssertTrue('the process span ended', WaitSpans('process q.handler', 1, 5000));
    TAssert.AssertEquals('the handler ran', 1, PcAtomicGet(FHandlerCalled));
    LProc := Span('process q.handler');
    FLock.Enter;
    try
      TAssert.AssertEquals('in the handler, the current trace is the message one', LProc.TraceId,
        FTraceInHandler);
      TAssert.AssertEquals('in the handler, the current span is the process', LProc.SpanId,
        FSpanInHandler);
    finally
      FLock.Leave;
    end;
    TAssert.AssertTrue('error status', LProc.Status = ssError);
    TAssert.AssertEquals('message', 'failed on purpose', LProc.StatusMessage);
    TAssert.AssertEquals('class', 'Exception', Attr(LProc, 'error.type'));
  finally
    LConn.Free;
  end;
end;

procedure TTracingTests.Get_ReceiveSpanIsChildOfCurrent;
var
  LConn: TAMQPConnection;
  LCh: TAMQPChannel;
  LParent: IPcSpan;
  LParentId: string;
  LGet: TAMQPGetResult;
  LFullSpan, LEmptySpan: TPcSpanData;
begin
  LConn := TAMQPConnection.Create(Params);
  try
    LConn.Open;
    LCh := LConn.CreateChannel;
    LCh.DeclareQueue(TAMQPQueueDeclare.Create('q.get', False));
    LCh.PublishText('', 'q.get', 'abc');

    LParent := TPcTracing.StartSpan('job', skInternal);
    LParentId := LParent.SpanId;
    try
      LGet := LCh.BasicGet('q.get', True);
      FreeHeaders(LGet);
      TAssert.AssertTrue('found', LGet.Found);
      LGet := LCh.BasicGet('q.get', True);
      TAssert.AssertFalse('empty', LGet.Found);
    finally
      LParent.Finish;
      LParent := nil;
    end;

    TAssert.AssertTrue('both receive spans', WaitSpans('receive q.get', 2, 5000));
    LFullSpan := Span('receive q.get', 0);
    LEmptySpan := Span('receive q.get', 1);
    TAssert.AssertTrue('client', LFullSpan.Kind = skClient);
    TAssert.AssertEquals('child of the current one', LParentId, LFullSpan.ParentSpanId);
    TAssert.AssertEquals('operation', 'receive', Attr(LFullSpan, 'messaging.operation.type'));
    TAssert.AssertEquals('size', '3', Attr(LFullSpan, 'messaging.message.body.size'));
    TAssert.AssertEquals('not empty', '', Attr(LFullSpan, 'pascalamqp.get.empty'));
    TAssert.AssertEquals('empty flagged', 'true', Attr(LEmptySpan, 'pascalamqp.get.empty'));
    TAssert.AssertEquals('empty without size', '', Attr(LEmptySpan, 'messaging.message.body.size'));
  finally
    LConn.Free;
  end;
end;

procedure TTracingTests.DeadLetter_PreservesTheTraceParent;
var
  LConn: TAMQPConnection;
  LCh: TAMQPChannel;
  LDecl: TAMQPQueueDeclare;
  LArgs: TAMQPFieldTable;
  LVal: TValue;
  LGet: TAMQPGetResult;
  LParent, LState: string;
  LDeadline: UInt64;
begin
  LConn := TAMQPConnection.Create(Params);
  try
    LConn.Open;
    LCh := LConn.CreateChannel;
    LCh.DeclareQueue(TAMQPQueueDeclare.Create('q.dlq', False));
    LArgs := TAMQPFieldTable.Create;
    try
      LVal := TValue.From<string>('');
      LArgs.Put('x-dead-letter-exchange', LVal);
      LVal := TValue.From<string>('q.dlq');
      LArgs.Put('x-dead-letter-routing-key', LVal);
      LDecl := TAMQPQueueDeclare.Create('q.source', False);
      LDecl.Arguments := LArgs;
      LCh.DeclareQueue(LDecl);
    finally
      LArgs.Free;
    end;
    LCh.PublishText('', 'q.source', 'rejected');

    LGet := LCh.BasicGet('q.source', False);
    FreeHeaders(LGet);
    TAssert.AssertTrue('found at the source', LGet.Found);
    LCh.Nack(LGet.DeliveryTag, False);

    // The dead-letter goes through the queue actor: asynchronous.
    LDeadline := PcTickMs + 5000;
    repeat
      LGet := LCh.BasicGet('q.dlq', True);
      if LGet.Found or (PcTickMs >= LDeadline) then
        Break;
      Sleep(10);
    until False;
    try
      TAssert.AssertTrue('reached the dlq', LGet.Found);
      TAssert.AssertTrue('with traceparent', AmqpTraceParentOf(LGet.Properties, LParent, LState));
      TAssert.AssertTrue('and the dead-letter x-death',
        LGet.Properties.Headers.ContainsKey('x-death'));
    finally
      FreeHeaders(LGet);
    end;
    TAssert.AssertTrue('the exported publish', WaitSpans('publish amq.default', 1, 5000));
    TAssert.AssertEquals('the same as the original publish',
      TraceParentOf(Span('publish amq.default')), LParent);
  finally
    LConn.Free;
  end;
end;

procedure TTracingTests.GeneratedQueue_TemporaryNameInSpan;
var
  LConn: TAMQPConnection;
  LCh: TAMQPChannel;
  LOk: TAMQPQueueDeclareOk;
  LDecl: TAMQPQueueDeclare;
  LProc: TPcSpanData;
begin
  LConn := TAMQPConnection.Create(Params);
  try
    LConn.Open;
    LCh := LConn.CreateChannel;
    LDecl := TAMQPQueueDeclare.Create('', False);
    LDecl.Exclusive := True;
    LOk := LCh.DeclareQueue(LDecl);
    LCh.Consume(LOk.QueueName, HandleDelivery, True);
    LCh.PublishText('', LOk.QueueName, 'oi');

    TAssert.AssertTrue('the process span ended', WaitSpans('process (temporary)', 1, 5000));
    LProc := Span('process (temporary)');
    TAssert.AssertEquals('the real name in the attribute', LOk.QueueName,
      Attr(LProc, 'messaging.destination.name'));
    TAssert.AssertEquals('flagged temporary', 'true',
      Attr(LProc, 'messaging.destination.temporary'));
  finally
    LConn.Free;
  end;
end;

procedure TTracingTests.TracerOff_DoesNotInjectHeader;
var
  LConn: TAMQPConnection;
  LCh: TAMQPChannel;
  LGet: TAMQPGetResult;
begin
  TPcTracing.Shutdown;
  LConn := TAMQPConnection.Create(Params);
  try
    LConn.Open;
    LCh := LConn.CreateChannel;
    LCh.DeclareQueue(TAMQPQueueDeclare.Create('q.off', False));
    LCh.PublishText('', 'q.off', 'oi');
    LGet := LCh.BasicGet('q.off', True);
    try
      TAssert.AssertTrue('found', LGet.Found);
      TAssert.AssertFalse('no headers', bpHeaders in LGet.Properties.Flags);
    finally
      FreeHeaders(LGet);
    end;
    TAssert.AssertEquals('no span', 0, FCollector.Count);
  finally
    LConn.Free;
  end;
end;

initialization
  TDUnitX.RegisterTestFixture(TTracingTests);

end.
