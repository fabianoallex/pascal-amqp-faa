unit AMQP.ServerEngineTests;

{ Tests for TAMQPMessage / AmqpSplitBody (AMQP.Server.Message) and for the
  resource descriptors / AmqpArgsEqual (AMQP.Server.Resources) -- WS1 of
  Phase 2 (in-memory routing engine, see CLAUDE.md).

  They are pure unit tests: neither starts a broker (unlike the
  fixtures of AMQP.ServerHandshakeTests).

  DUnitX master in FPCUnit's dialect (TAssert.*); the FPCUnit mirror in
  fpc\ is generated by tools/gen_fpc_mirror.py. }


interface

uses
  DUnitX.TestFramework,
  AMQP.DUnitXCompat,
  SysUtils, Rtti,
  AMQP.Wire,
  AMQP.Exchange.Methods,
  AMQP.Basic.Methods,
  AMQP.Server.Types,
  AMQP.Server.Message,
  AMQP.Server.Resources,
  AMQP.Server.Header;

type
  [TestFixture]
  TMessageTests = class
  public
    [Test] procedure NasceComRefCount1;
    [Test] procedure AddRefSobeReleaseDesce;
    [Test] procedure UltimoReleaseLibera;
    [Test] procedure CorpoCompartilhadoSemCopia;
