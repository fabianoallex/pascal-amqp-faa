{ Asynchronous confirm tied to the watermark -- WS5 of Phase 4 (durability,
  see CLAUDE.md, decisions D19-D28; this is D24).

  It is the bottom layer, and WS5's anchor test: the tracker with a
  REAL TAMQPFrameWriter over a recording stream, so the assertions are
  about the FRAMES THAT WENT OUT ON THE WIRE and not about internal state. It is
  deterministic end to end -- the watermark comes in as a PARAMETER, not
  from an fsync -- and so nothing here depends on time.

  What these tests pin down, and that no end-to-end suite pins down:

  1. The confirm does NOT go out before the LSN is durable. It is the reason WS5
     exists; without this the broker would promise durability it does not yet have.

  2. Corollary (a) of D24 -- confirms go out in seq order PER CHANNEL. A
     TRANSIENT publish behind a pending persistent one WAITS, and goes out
     collapsed with it. A client test does not catch this: it waits for all
     the seqs and would stay green with the order swapped.

  3. D9's collapse -- N confirms become ONE Basic.Ack with multiple=true. It is not
     enough that "the confirm arrived": an implementation that emitted one frame per seq
     would pass any test that only counted received confirms.

  4. The fast path stays fast: with no LSN and nothing pending, nothing is deferred --
     the broker without DataDir is letter for letter Phase 3's (D19).

  The three Check* functions exist so the test bodies are IDENTICAL in the
  two dialects: only their implementation changes side. }

{ DUnitX master in FPCUnit's dialect (TAssert.*); the FPCUnit mirror in
  fpc\ is generated by tools/gen_fpc_mirror.py. }


interface

uses
  fpcunit, testregistry,
  SysUtils, Classes,
  AMQP.Protocol,
  AMQP.Frame,
  AMQP.Wire,
  AMQP.Basic.Methods,
  AMQP.Server.Types,
  AMQP.Server.FrameIO,
  AMQP.Server.Journal,
  AMQP.Server.Confirm,
  AMQP.ServerTestDoubles;

type
  { A Basic.Ack/Nack read from the wire. }
  TReadConfirm = record
    Seq: UInt64;
    Multiple: Boolean;
    Nack: Boolean;
  end;

  { The bottom layer of the asynchronous confirm: a channel tracker. }
  TConfirmTrackerTests = class(TTestCase)
  private
    FStream: TRecordingStream;
    FWriter: TAMQPFrameWriter;
    FTracker: IAMQPConfirmTracker;
    /// Confirms written so far, decoded from the wire. STOPS the writer thread --
    /// call it only once, at the end of the test.
    function Confirms: TArray<TReadConfirm>;
  protected
    procedure SetUp; override;
    procedure TearDown; override;
  published
    procedure NoLsnAndNoPending_DoesNotDefer;
    procedure WithLsn_Defers_AndOnlyLeavesAfterTheMark;
    procedure TransientBehindPersistent_Waits;
    procedure SeveralPersistent_LeaveInOneAckWithMultiple;
    procedure PartialMark_ReleasesOnlyThePrefix;
    procedure Nack_GoesOutAlone_AndBreaksTheCollapse;
    procedure FailedJournal_AllPendingBecomesNack;
    procedure DeadChannel_WritesNothing;
    procedure FullOutput_DoesNotBlockTheReleaser;
  end;

  { The registry: the bridge between the journal thread and the channels. }
  TConfirmRegistryTests = class(TTestCase)
  published
    procedure Durable_ReleasesAllTrackers;
    procedure Unregister_StopsNotifying;
    procedure Watermark_TracksTheLastDurable;
  end;

implementation

// Assertions with a fixed type: the value comes in already converted, and the
// TAssert overload is the same on both compilers.
procedure CheckInt(const AMsg: string; AExpected, AActual: Integer);
begin
  TAssert.AssertEquals(AMsg, AExpected, AActual);
end;

procedure CheckOk(const AMsg: string; ACond: Boolean);
begin
  TAssert.AssertTrue(AMsg, ACond);
end;

procedure CheckNot(const AMsg: string; ACond: Boolean);
begin
  TAssert.AssertFalse(AMsg, ACond);
end;

function ReadConfirms(const AFrames: TArray<TAMQPFrame>): TArray<TReadConfirm>;
var
  I: Integer;
  LReader: TAMQPReader;
  LClassName, LMethod: Word;
  LAck: TAMQPBasicAck;
  LNack: TAMQPBasicNack;
begin
  SetLength(Result, Length(AFrames));
  for I := 0 to High(AFrames) do
  begin
    LReader := TAMQPReader.Create(AFrames[I].Payload);
    try
      LClassName := LReader.ReadShortUInt;
      LMethod := LReader.ReadShortUInt;
      Result[I].Nack := (LClassName = AMQP_CLASS_BASIC)
        and (LMethod = AMQP_BASIC_NACK);
      if Result[I].Nack then
      begin
        LNack := DecodeBasicNack(LReader);
        Result[I].Seq := LNack.DeliveryTag;
        Result[I].Multiple := LNack.Multiple;
      end
      else
      begin
        LAck := DecodeBasicAck(LReader);
        Result[I].Seq := LAck.DeliveryTag;
        Result[I].Multiple := LAck.Multiple;
      end;
    finally
      LReader.Free;
    end;
  end;
end;

{ --- TConfirmTrackerTests --- }

procedure TConfirmTrackerTests.SetUp;
begin
  FStream := TRecordingStream.Create;
  FWriter := TAMQPFrameWriter.Create(FStream);
  FTracker := TAMQPConfirmTracker.Create(FWriter, 7);
end;

procedure TConfirmTrackerTests.TearDown;
begin
  FTracker := nil;
  FWriter.Free;
  FStream.Free;
end;

function TConfirmTrackerTests.Confirms: TArray<TReadConfirm>;
begin
  Result := ReadConfirms(WrittenFrames(FWriter, FStream));
end;

procedure TConfirmTrackerTests.NoLsnAndNoPending_DoesNotDefer;
begin
  // Phase 3's fast path still exists: a transient publish on a
  // channel with nothing pending confirms RIGHT AWAY, without going through the tracker.
  CheckNot('does not defer', FTracker.TryDefer(1, 0, False));
  CheckInt('nothing left pending', 0, FTracker.PendingCount);
  CheckInt('and nothing was written on our behalf', 0, Length(Confirms));
end;

procedure TConfirmTrackerTests.WithLsn_Defers_AndOnlyLeavesAfterTheMark;
var
  LC: TArray<TReadConfirm>;
begin
  // The reason WS5 exists: with an LSN to wait for, the frame does NOT go out until the
  // disk answers.
  CheckOk('deferred', FTracker.TryDefer(1, 10, False));
  FTracker.Release(9); // the watermark has not reached it yet
  CheckInt('still pending with the watermark at 9', 1, FTracker.PendingCount);
  FTracker.Release(10);
  CheckInt('released with the watermark at 10', 0, FTracker.PendingCount);
  LC := Confirms;
  CheckInt('one confirm', 1, Length(LC));
  CheckInt('for seq 1', 1, Integer(LC[0].Seq));
  CheckNot('and it is not a nack', LC[0].Nack);
end;

procedure TConfirmTrackerTests.TransientBehindPersistent_Waits;
var
  LC: TArray<TReadConfirm>;
begin
  // Corollary (a) of D24. Seq 2 wrote nothing to disk and could go out
  // now -- but going out now would break the channel's confirm order, and the client
  // would see the ack for 2 before the one for 1. It waits, and goes out COLLAPSED with 1.
  CheckOk('the persistent one defers', FTracker.TryDefer(1, 10, False));
  CheckOk('and the transient one behind it ALSO defers', FTracker.TryDefer(2, 0, False));
  FTracker.Release(9);
  CheckInt('neither went out', 2, FTracker.PendingCount);
  FTracker.Release(10);
  CheckInt('both went out together', 0, FTracker.PendingCount);
  LC := Confirms;
  CheckInt('in a single frame', 1, Length(LC));
  CheckInt('with the HIGHEST seq', 2, Integer(LC[0].Seq));
  CheckOk('and multiple=true, which is what settles seq 1', LC[0].Multiple);
end;

procedure TConfirmTrackerTests.SeveralPersistent_LeaveInOneAckWithMultiple;
var
  LC: TArray<TReadConfirm>;
  I: Integer;
begin
  // The letter of D9: the whole prefix becomes ONE frame.
  for I := 1 to 5 do
    CheckOk('deferred ' + IntToStr(I), FTracker.TryDefer(I, 100 + I, False));
  FTracker.Release(105);
  LC := Confirms;
  CheckInt('five confirms in a single frame', 1, Length(LC));
  CheckInt('seq of the last one', 5, Integer(LC[0].Seq));
  CheckOk('multiple', LC[0].Multiple);
end;

procedure TConfirmTrackerTests.PartialMark_ReleasesOnlyThePrefix;
var
  LC: TArray<TReadConfirm>;
begin
  // Watermark in the middle: the prefix goes out, the rest stays. An fsync batch does not need
  // to cover everything that is pending.
  FTracker.TryDefer(1, 10, False);
  FTracker.TryDefer(2, 20, False);
  FTracker.TryDefer(3, 30, False);
  FTracker.Release(20);
  CheckInt('seq 3 is left', 1, FTracker.PendingCount);
  LC := Confirms;
  CheckInt('one frame', 1, Length(LC));
  CheckInt('up to seq 2', 2, Integer(LC[0].Seq));
  CheckOk('multiple', LC[0].Multiple);
end;

procedure TConfirmTrackerTests.Nack_GoesOutAlone_AndBreaksTheCollapse;
var
  LC: TArray<TReadConfirm>;
begin
  // A Nack marks ONE seq: it cannot be collapsed with its neighbours. So the
  // accumulated ack goes out BEFORE it, and accumulation restarts after.
  FTracker.TryDefer(1, 10, False);
  FTracker.TryDefer(2, 0, True);  // reject-publish: nack, and does not wait for disk
  FTracker.TryDefer(3, 0, False);
  FTracker.Release(10);
  CheckInt('everything went out', 0, FTracker.PendingCount);
  LC := Confirms;
  CheckInt('three frames, not one', 3, Length(LC));
  CheckInt('1st: ack up to seq 1', 1, Integer(LC[0].Seq));
  CheckNot('1st is not a nack', LC[0].Nack);
  CheckInt('2nd: the nack for seq 2', 2, Integer(LC[1].Seq));
  CheckOk('2nd is a nack', LC[1].Nack);
  CheckNot('and a nack never goes with multiple', LC[1].Multiple);
  CheckInt('3rd: ack for seq 3', 3, Integer(LC[2].Seq));
  CheckNot('3rd is not a nack', LC[2].Nack);
end;

procedure TConfirmTrackerTests.FailedJournal_AllPendingBecomesNack;
var
  LC: TArray<TReadConfirm>;
begin
  // The watermark will not move any more. Leaving the publisher hanging would be the worst of
  // all worlds: it would see neither success nor failure.
  FTracker.TryDefer(1, 10, False);
  FTracker.TryDefer(2, 20, False);
  FTracker.FailAll;
  CheckInt('nothing got stuck', 0, FTracker.PendingCount);
  LC := Confirms;
  CheckInt('one nack per seq', 2, Length(LC));
  CheckOk('the 1st is a nack', LC[0].Nack);
  CheckOk('the 2nd is a nack', LC[1].Nack);
  CheckInt('seq 1', 1, Integer(LC[0].Seq));
  CheckInt('seq 2', 2, Integer(LC[1].Seq));
end;

procedure TConfirmTrackerTests.DeadChannel_WritesNothing;
begin
  // The one releasing is the JOURNAL thread, and the channel may have died meanwhile.
  // After Detach nothing is written -- and nothing is deferred, because there is no one
  // to confirm to.
  FTracker.TryDefer(1, 10, False);
  FTracker.Detach;
  CheckInt('the pending one was discarded', 0, FTracker.PendingCount);
  FTracker.Release(10);
  CheckNot('and it no longer defers', FTracker.TryDefer(2, 10, False));
  CheckInt('no frame', 0, Length(Confirms));
end;

procedure TConfirmTrackerTests.FullOutput_DoesNotBlockTheReleaser;
var
  LC: TArray<TReadConfirm>;
begin
  // D3's shape applied to the confirm: the caller of Release is the
  // JOURNAL thread, and it cannot wait for a channel's write queue to empty.
  // With the stream blocked, if the release used PostFrames instead of
  // TryPostFrames this test would NOT RETURN -- the suite would hang instead of
  // failing, which is the symptom to recognize if it ever hangs.
  FStream.Block;
  try
    FTracker.TryDefer(1, 10, False);
    FTracker.Release(10);
    CheckInt('the release returned without waiting for the stream', 0,
      FTracker.PendingCount);
  finally
    FStream.Unblock;
  end;
  LC := Confirms;
  CheckInt('and the frame went out once the stream unblocked', 1, Length(LC));
  CheckInt('seq 1', 1, Integer(LC[0].Seq));
end;

{ --- TConfirmRegistryTests --- }

procedure TConfirmRegistryTests.Durable_ReleasesAllTrackers;
var
  LRec: IAMQPConfirmRegistry;
  LSink: IAMQPDurabilitySink;
  LStreamA, LStreamB: TRecordingStream;
  LWriterA, LWriterB: TAMQPFrameWriter;
  LA, LB: IAMQPConfirmTracker;
begin
  LStreamA := TRecordingStream.Create;
  LStreamB := TRecordingStream.Create;
  LWriterA := TAMQPFrameWriter.Create(LStreamA);
  LWriterB := TAMQPFrameWriter.Create(LStreamB);
  try
    LRec := TAMQPConfirmRegistry.Create;
    LSink := LRec as IAMQPDurabilitySink;
    LA := LRec.CreateTracker(LWriterA, 1);
    LB := LRec.CreateTracker(LWriterB, 2);
    LA.TryDefer(1, 10, False);
    LB.TryDefer(1, 10, False);
    // ONE fsync unblocks BOTH channels: that is what "watermark of the whole
    // broker" means.
    LSink.Durable(10);
    CheckInt('channel A released', 0, LA.PendingCount);
    CheckInt('channel B released', 0, LB.PendingCount);
    CheckInt('one confirm on A', 1, Length(ReadConfirms(WrittenFrames(LWriterA, LStreamA))));
    CheckInt('one confirm on B', 1, Length(ReadConfirms(WrittenFrames(LWriterB, LStreamB))));
    LA := nil;
    LB := nil;
    LSink := nil;
    LRec := nil;
  finally
    LWriterA.Free;
    LWriterB.Free;
    LStreamA.Free;
    LStreamB.Free;
  end;
end;

procedure TConfirmRegistryTests.Unregister_StopsNotifying;
var
  LRec: IAMQPConfirmRegistry;
  LSink: IAMQPDurabilitySink;
  LStream: TRecordingStream;
  LWriter: TAMQPFrameWriter;
  LT: IAMQPConfirmTracker;
begin
  LStream := TRecordingStream.Create;
  LWriter := TAMQPFrameWriter.Create(LStream);
  try
    LRec := TAMQPConfirmRegistry.Create;
    LSink := LRec as IAMQPDurabilitySink;
    LT := LRec.CreateTracker(LWriter, 1);
    LT.TryDefer(1, 10, False);
    LRec.Unregister(LT);
    LSink.Durable(10);
    // Without Unregister, the journal thread would walk trackers of dead
    // channels on every fsync, forever.
    CheckInt('the unregistered one was not notified', 1, LT.PendingCount);
    LT.Detach; // otherwise the writer's TearDown would find it alive
    LT := nil;
    LSink := nil;
    LRec := nil;
  finally
    LWriter.Free;
    LStream.Free;
  end;
end;

procedure TConfirmRegistryTests.Watermark_TracksTheLastDurable;
var
  LRec: IAMQPConfirmRegistry;
  LSink: IAMQPDurabilitySink;
begin
  LRec := TAMQPConfirmRegistry.Create;
  LSink := LRec as IAMQPDurabilitySink;
  CheckInt('starts at zero', 0, Integer(LRec.Watermark));
  LSink.Durable(42);
  CheckInt('advances with the fsync', 42, Integer(LRec.Watermark));
  // RetryPending recovers what got stuck without INVENTING durability.
  LRec.RetryPending;
  CheckInt('the retry does not touch the watermark', 42, Integer(LRec.Watermark));
  LSink := nil;
  LRec := nil;
end;

initialization
  RegisterTest(TConfirmTrackerTests);
  RegisterTest(TConfirmRegistryTests);

end.
