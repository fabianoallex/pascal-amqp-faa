  end;
end;

procedure TQueueDeliveryTests.RoundRobin_AlternatesBetweenConsumers;
var
  LQ: TAMQPServerQueue;
  LA, LB: TFakeTarget;
  LRefA, LRefB: IAMQPDeliveryTarget;
  I: Integer;
begin
  LQ := TAMQPServerQueue.Create('q');
  try
    LA := TFakeTarget.Create(1);
    LRefA := LA;
    LB := TFakeTarget.Create(2);
    LRefB := LB;
    LQ.PostAddConsumer(TAMQPServerConsumer.Create('ca', True, False, LRefA));
    LQ.PostAddConsumer(TAMQPServerConsumer.Create('cb', True, False, LRefB));

    for I := 1 to 4 do
      PublishText(LQ, 'm' + IntToStr(I));
    LQ.Stats; // barreira

    TAssert.AssertEquals('half to the first', 2, LA.Count);
    TAssert.AssertEquals('half to the second', 2, LB.Count);
    TAssert.AssertEquals('alternated', 'm1|m3', LA.Bodies);
    TAssert.AssertEquals('alternated', 'm2|m4', LB.Bodies);
  finally
    LQ.Free;
  end;
end;

procedure TQueueDeliveryTests.RefusingConsumer_DoesNotBlockTheOthers;
var
  LQ: TAMQPServerQueue;
  LA, LB: TFakeTarget;
  LRefA, LRefB: IAMQPDeliveryTarget;
  I: Integer;
begin
  LQ := TAMQPServerQueue.Create('q');
  try
    LA := TFakeTarget.Create(1);
    LA.Refuse := True; // slow consumer: outbound queue full (D3)
    LRefA := LA;
    LB := TFakeTarget.Create(2);
    LRefB := LB;
    LQ.PostAddConsumer(TAMQPServerConsumer.Create('ca', True, False, LRefA));
    LQ.PostAddConsumer(TAMQPServerConsumer.Create('cb', True, False, LRefB));

    for I := 1 to 3 do
      PublishText(LQ, 'm' + IntToStr(I));

    TAssert.AssertEquals('nothing got stuck', 0, LQ.Stats.MessageCount);
    TAssert.AssertEquals('the refusing one receives nothing', 0, LA.Count);
    TAssert.AssertEquals('the other consumer gets everything, no head-of-line', 'm1|m2|m3', LB.Bodies);
  finally
    LQ.Free;
  end;
end;

