procedure TDeliveryTargetTests.NoteResolved_MultipleResolvesPrefix;
var
  LStream: TRecordingStream;
  LWriter: TAMQPFrameWriter;
  LTarget: TAMQPChannelDeliveryTarget;
  LRef: IAMQPDeliveryTarget;
  LMsg: TAMQPMessage;
  LTag: UInt64;
  I: Integer;
begin
  LStream := TRecordingStream.Create;
  LWriter := TAMQPFrameWriter.Create(LStream);
  try
    LTarget := TAMQPChannelDeliveryTarget.Create(LWriter, 1, 0);
    LRef := LTarget;
    LMsg := NewMessage('m');
    try
      for I := 1 to 4 do
        LTarget.TryDeliver('ct', 'q', False, False, LMsg, LTag);
      TAssert.AssertEquals('four pending', 4, LTarget.UnackedCount);

      TAssert.AssertEquals('multiple up to tag 2', 2, Length(LTarget.NoteResolved(2, True)));
      TAssert.AssertEquals('two left', 2, LTarget.UnackedCount);
      TAssert.AssertEquals('an already settled tag does not count again', 0, Length(LTarget.NoteResolved(2, False)));
      TAssert.AssertEquals('multiple with tag 0 settles every pending one', 2, Length(LTarget.NoteResolved(0, True)));
      TAssert.AssertEquals('nothing pending', 0, LTarget.UnackedCount);
    finally
      LMsg.Release;
    end;
  finally
    LWriter.Stop;
    LWriter.Free;
    LStream.Free;
  end;
end;

procedure TDeliveryTargetTests.Detach_RefusesAndStopsBeingAlive;
var
  LStream: TRecordingStream;
  LWriter: TAMQPFrameWriter;
  LTarget: TAMQPChannelDeliveryTarget;
  LRef: IAMQPDeliveryTarget;
  LMsg: TAMQPMessage;
  LTag: UInt64;
begin
  LStream := TRecordingStream.Create;
  LWriter := TAMQPFrameWriter.Create(LStream);
  try
    LTarget := TAMQPChannelDeliveryTarget.Create(LWriter, 1, 0);
    LRef := LTarget;
    TAssert.AssertTrue('born alive', LTarget.IsAlive);

    LTarget.Detach;
    TAssert.AssertFalse('dead after detach', LTarget.IsAlive);

    LMsg := NewMessage('m');
    try
      TAssert.AssertFalse('no delivery after detach', LTarget.TryDeliver('ct', 'q', True, False, LMsg, LTag));
    finally
      LMsg.Release;
    end;
    LTarget.Detach; // idempotente
  finally
    LWriter.Stop;
    LWriter.Free;
    LStream.Free;
    // The target (LRef) only dies here, AFTER the writer -- it is exactly the
    // situation refcount+detach exists to make safe.
  end;
end;

procedure TDeliveryTargetTests.FullWriteQueue_RefusesWithoutBlocking;
var
  LStream: TRecordingStream;
  LWriter: TAMQPFrameWriter;
  LTarget: TAMQPChannelDeliveryTarget;
  LRef: IAMQPDeliveryTarget;
  LMsg: TAMQPMessage;
  LTag: UInt64;
  I: Integer;
  LRefused: Boolean;
  LStart: UInt64;
begin
  LStream := TRecordingStream.Create;
  LStream.Block; // the writer thread blocks on the first Write: the queue fills up
  LWriter := TAMQPFrameWriter.Create(LStream, 8);
  try
    LTarget := TAMQPChannelDeliveryTarget.Create(LWriter, 1, 0);
    LRef := LTarget;
    LMsg := NewMessage('m');
    try
      LRefused := False;
      LStart := PcTickMs;
      for I := 1 to 50 do
        if not LTarget.TryDeliver('ct', 'q', True, False, LMsg, LTag) then
        begin
          LRefused := True;
          Break;
        end;
      TAssert.AssertTrue('with the write queue full, the target refuses', LRefused);
      TAssert.AssertTrue('and refuses WITHOUT BLOCKING -- what D2/D3 require of the actor', PcTickMs - LStart < 2000);
    finally
      LMsg.Release;
    end;
  finally
    LStream.Unblock; // releases the writer thread before shutting down
    LWriter.Stop;
    LWriter.Free;
    LStream.Free;
  end;
end;

procedure TDeliveryTargetTests.TryPostFrames_AtomicBatchOrNothing;
var
  LStream: TRecordingStream;
  LWriter: TAMQPFrameWriter;
  LBatch: array[0..2] of TAMQPFrame;
  I: Integer;
  LFitted: Boolean;
  LFrames: TArray<TAMQPFrame>;
begin
  LStream := TRecordingStream.Create;
  LStream.Block;
  LWriter := TAMQPFrameWriter.Create(LStream, 4);
  try
    for I := 0 to 2 do
      LBatch[I] := TAMQPFrame.Create(AMQP_FRAME_BODY, 1,
        AmqpUtf8Encode('batch' + IntToStr(I)));

    // Fills the queue (the writer thread is stuck in Write).
    LFitted := True;
    for I := 1 to 20 do
      if not LWriter.TryPostFrames([TAMQPFrame.Create(AMQP_FRAME_BODY, 1,
        AmqpUtf8Encode('x'))]) then
      begin
        LFitted := False;
        Break;
      end;
    TAssert.AssertFalse('the write queue filled up', LFitted);
    TAssert.AssertFalse('batch does not fit: refused whole', LWriter.TryPostFrames(LBatch));

    LStream.Unblock;
    LFrames := WrittenFrames(LWriter, LStream);
    for I := 0 to High(LFrames) do
      TAssert.AssertEquals('no frame of the refused batch leaked to the wire', 'x', AmqpUtf8Decode(LFrames[I].Payload));
  finally
    LStream.Unblock;
    LWriter.Free;
    LStream.Free;
  end;
end;

procedure TDeliveryTargetTests.Channel_FreedDetachesTheTarget;
var
  LStream: TRecordingStream;
  LWriter: TAMQPFrameWriter;
  LChannel: TAMQPServerChannel;
  LRef: IAMQPDeliveryTarget;
  LMsg: TAMQPMessage;
  LTag: UInt64;
begin
  LStream := TRecordingStream.Create;
  LWriter := TAMQPFrameWriter.Create(LStream);
  try
    LChannel := TAMQPServerChannel.Create(5);
    LChannel.AttachDelivery(LWriter, 0);
    LRef := LChannel.DeliveryTarget; // it is what a queue would keep in the consumer
    TAssert.AssertTrue('target alive while the channel is open', LRef.IsAlive);

    // The channel dies (Channel.Close, connection drop, reaper...). The queue still
    // holds the interface -- and that is exactly why the object must NOT
    // be freed, nor keep writing to a writer that is going away.
    LChannel.Free;

    TAssert.AssertFalse('freeing the channel must detach the target, or the queue delivers to a dead writer',
      LRef.IsAlive);
    LMsg := NewMessage('m');
    try
      TAssert.AssertFalse('and every later delivery fails cleanly',
        LRef.TryDeliver('ct', 'q', True, False, LMsg, LTag));
    finally
      LMsg.Release;
    end;
  finally
    LWriter.Stop;
    LWriter.Free;
    LStream.Free;
  end;
end;

procedure TDeliveryTargetTests.Channel_PropagatesFlowAndPrefetchToTheTarget;
var
  LStream: TRecordingStream;
  LWriter: TAMQPFrameWriter;
  LChannel: TAMQPServerChannel;
  LRef: IAMQPDeliveryTarget;
  LMsg: TAMQPMessage;
  LTag: UInt64;
begin
  LStream := TRecordingStream.Create;
  LWriter := TAMQPFrameWriter.Create(LStream);
  try
    LChannel := TAMQPServerChannel.Create(1);
    try
      LChannel.AttachDelivery(LWriter, 0);
      LRef := LChannel.DeliveryTarget;
      LMsg := NewMessage('m');
      try
        // Channel.Flow reaches the target.
        LChannel.Active := False;
        TAssert.AssertFalse('Channel.Flow=False stops delivery',
          LRef.TryDeliver('ct', 'q', True, False, LMsg, LTag));
        LChannel.Active := True;

        // Basic.Qos too.
        LChannel.PrefetchCount := 1;
        TAssert.AssertTrue('1a', LRef.TryDeliver('ct', 'q', False, False, LMsg, LTag));
        TAssert.AssertFalse('channel prefetch applies to the target',
          LRef.TryDeliver('ct', 'q', False, False, LMsg, LTag));
      finally
        LMsg.Release;
      end;
    finally
      LChannel.Free;
    end;
  finally
    LWriter.Stop;
    LWriter.Free;
    LStream.Free;
  end;
end;

initialization
  RegisterTest(TQueueDeliveryTests);
  RegisterTest(TDeliveryTargetTests);

end.
