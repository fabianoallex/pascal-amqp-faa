function NewMessage(const AText: string): TAMQPMessage;
begin
  Result := TAMQPMessage.Create('ex', 'rk', 'guest', nil,
    AmqpUtf8Encode(AText));
end;

// Publishes AText to the queue and drops the publisher's reference.
procedure PublishText(AQueue: TAMQPServerQueue; const AText: string);
var
  LMsg: TAMQPMessage;
begin
  LMsg := NewMessage(AText);
  try
    AQueue.PostMessage(LMsg);
  finally
    LMsg.Release;
  end;
end;

{ --- TQueueDeliveryTests --- }

procedure TQueueDeliveryTests.Consumer_ReceivesOnPublish;
var
  LQ: TAMQPServerQueue;
  LTarget: TFakeTarget;
  LRef: IAMQPDeliveryTarget;
  LStats: TAMQPQueueStats;
begin
  LQ := TAMQPServerQueue.Create('q');
  try
    LTarget := TFakeTarget.Create(1);
    LRef := LTarget;
    LQ.PostAddConsumer(TAMQPServerConsumer.Create('ct', False, False, LRef));
    PublishText(LQ, 'a');

    LStats := LQ.Stats; // barrier: the mailbox is serial
    TAssert.AssertEquals('delivered', 1, LTarget.Count);
    TAssert.AssertEquals('body', 'a', LTarget.DeliveryAt(0).BodyText);
    TAssert.AssertEquals('consumer tag', 'ct', LTarget.DeliveryAt(0).ConsumerTag);
    TAssert.AssertEquals('queue name', 'q', LTarget.DeliveryAt(0).QueueName);
    TAssert.AssertFalse('first delivery', LTarget.DeliveryAt(0).Redelivered);
    TAssert.AssertEquals('left the ready set', 0, LStats.MessageCount);
    TAssert.AssertEquals('became unacked', 1, LStats.UnackedCount);
    TAssert.AssertEquals('counted the delivery', 1, Integer(LStats.DeliveredCount));
  finally
    LQ.Free;
  end;
end;

procedure TQueueDeliveryTests.NewConsumer_ReceivesWhatWasAlreadyQueued;
var
  LQ: TAMQPServerQueue;
  LTarget: TFakeTarget;
  LRef: IAMQPDeliveryTarget;
begin
  LQ := TAMQPServerQueue.Create('q');
  try
    PublishText(LQ, 'a');
    PublishText(LQ, 'b');
    TAssert.AssertEquals('piled up with no consumer', 2, LQ.Stats.MessageCount);

    LTarget := TFakeTarget.Create(1);
    LRef := LTarget;
    LQ.PostAddConsumer(TAMQPServerConsumer.Create('ct', True, False, LRef));
    TAssert.AssertEquals('drained when the consumer arrived', 0, LQ.Stats.MessageCount);
    TAssert.AssertEquals('in queue order', 'a|b', LTarget.Bodies);
  finally
    LQ.Free;
  end;
end;

procedure TQueueDeliveryTests.NoAck_LeavesNoUnacked;
var
  LQ: TAMQPServerQueue;
  LTarget: TFakeTarget;
  LRef: IAMQPDeliveryTarget;
  LMsg: TAMQPMessage;
begin
  LQ := TAMQPServerQueue.Create('q');
  try
    LTarget := TFakeTarget.Create(1);
    LRef := LTarget;
    LQ.PostAddConsumer(TAMQPServerConsumer.Create('ct', True, False, LRef));

    LMsg := NewMessage('a');
