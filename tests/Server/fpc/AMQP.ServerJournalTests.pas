    TAssert.AssertEquals('2o lote continua', Int64(2), Int64(J.Submit(Um(1, 'b'))));
    TAssert.AssertEquals('3o lote continua', Int64(3), Int64(J.Submit(Um(1, 'c'))));
    TAssert.AssertTrue('tudo duravel', J.WaitDurable(3, 5000));
  finally
    J.Free;
  end;
end;

