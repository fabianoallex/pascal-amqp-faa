procedure TJournalDurabilityTests.FsyncOk_AdvancesTheWatermark;
var
  J: TJournalOverDouble;
  LSN: UInt64;
begin
  J := TJournalOverDouble.Create(FDir);
  try
    J.Start;
    LSN := J.Submit(OneRecord(1, 'a'));
    TAssert.AssertTrue('ficou duravel', J.WaitDurable(LSN, 5000));
