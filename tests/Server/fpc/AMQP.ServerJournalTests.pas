procedure JournalTearDown(var FDir: string);
var
  LRec: TSearchRec;
begin
  if FindFirst(IncludeTrailingPathDelimiter(FDir) + '*', faAnyFile, LRec) = 0 then
  begin
    try
      repeat
        if (LRec.Attr and faDirectory) = 0 then
          DeleteFile(IncludeTrailingPathDelimiter(FDir) + LRec.Name);
      until FindNext(LRec) <> 0;
    finally
      FindClose(LRec);
    end;
  end;
end;

procedure JournalSetUp(var FDir: string);
begin
  Inc(GSeq);
  FDir := IncludeTrailingPathDelimiter(TempDir) + 'amqpjournal-'
    + IntToStr(GSeq);
  JournalTearDown(FDir); // ensures a clean directory even after an interrupted run
  ForceDirectories(FDir);
end;

function Rec(AKind: Byte; const S: string): TAMQPJournalRecord;
var
  I: Integer;
begin
  Result.Kind := AKind;
  SetLength(Result.Payload, Length(S));
  for I := 1 to Length(S) do
    Result.Payload[I - 1] := Byte(S[I]);
end;

function OneRecord(AKind: Byte; const S: string): TAMQPJournalRecords;
begin
  SetLength(Result, 1);
  Result[0] := Rec(AKind, S);
end;

