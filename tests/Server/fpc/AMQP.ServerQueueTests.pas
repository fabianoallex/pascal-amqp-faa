  try
    LQ.DeadLetterSink := LSink;
    PublishWithHeader(LQ, 'm');
    LQ.Get(1, 5, False, LMsg, LRedel);
    LMsg.Release;
    LQ.PostNack(1, 5, False, False);
    Stabilize(LQ);
    CheckStr('chave original preservada', 'rk.origem', LSink.Item(0).RoutingKey);
  finally
