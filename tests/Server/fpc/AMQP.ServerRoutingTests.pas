// The AE can be of any type -- including headers, which matches on the table.
procedure TVHostTests.Ae_CanBeOfAnotherType;
var
  LVHost: TAMQPVHost;
  LArgs, LHeaders: TAMQPFieldTable;
  LResult: TArray<string>;
  LVal: TValue;
begin
  LVHost := TAMQPVHost.Create;
  try
    LVHost.DeclareExchange('ae', AMQP_EXCHANGE_TYPE_HEADERS, True, False,
      False, nil);
    LVHost.DeclareExchange('ex', AMQP_EXCHANGE_TYPE_DIRECT, True, False,
      False, AeArgs('ae'));
    LVHost.DeclareQueue('q.ae', True, False, False, nil);
    LArgs := TAMQPFieldTable.Create;
    LVal := TValue.From<string>('south');
    LArgs.Put('region', LVal);
    LVHost.BindQueue('ae', 'q.ae', '', LArgs); // the vhost takes ownership

    LHeaders := TAMQPFieldTable.Create;
    try
      LVal := TValue.From<string>('south');
      LHeaders.Put('region', LVal);
      LResult := LVHost.Route('ex', 'nothing-matches', LHeaders);
      TAssert.AssertEquals('the headers AE matched', 1, Length(LResult));
      TAssert.AssertEquals('q.ae', LResult[0]);
    finally
      LHeaders.Free;
    end;
  finally
    LVHost.Free;
  end;
end;


// The visited set does NOT exist only to cut cycles -- the depth cap
// alone would already make the cycle end. It exists so the DENSE graph
// does not blow up: with N distinct paths per level and depth D, a
// traversal with no memory of visited nodes costs N^D. Measured: without the visited set this
// test takes seconds; with it, milliseconds.
//
// It is the same family as the topic matcher's ManyHashes_DoesNotExplode: the match
// runs on the PUBLISHER thread holding the read RWLock, so a
// hostile declare would turn into a hang of the whole broker.
procedure TVHostTests.Route_DenseGraph_DoesNotExplode;
var
  LVHost: TAMQPVHost;
  LResult: TArray<string>;
  I: Integer;
  LStart: UInt64;
begin
  LVHost := TAMQPVHost.Create;
  try
    for I := 0 to 15 do
      LVHost.DeclareExchange('e' + IntToStr(I), AMQP_EXCHANGE_TYPE_FANOUT,
        True, False, False, nil);
    // Three distinct paths from each level to the next: 3^15 traversals
    // if there is no memory of where we have already been.
    for I := 0 to 14 do
    begin
      LVHost.BindExchange('e' + IntToStr(I + 1), 'e' + IntToStr(I), 'a', nil);
      LVHost.BindExchange('e' + IntToStr(I + 1), 'e' + IntToStr(I), 'b', nil);
      LVHost.BindExchange('e' + IntToStr(I + 1), 'e' + IntToStr(I), 'c', nil);
    end;
    LVHost.DeclareQueue('q.end', True, False, False, nil);
    LVHost.BindQueue('e15', 'q.end', '', nil);

    LStart := PcTickMs;
    LResult := LVHost.Route('e0', 'whatever', nil);
    TAssert.AssertEquals('reached the end', 1, Length(LResult));
    TAssert.AssertTrue('traversal must be linear, not exponential (took '
      + IntToStr(PcTickMs - LStart) + ' ms)', (PcTickMs - LStart) < 500);
  finally
    LVHost.Free;
  end;
end;

