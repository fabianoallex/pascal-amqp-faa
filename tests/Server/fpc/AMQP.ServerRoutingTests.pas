procedure TVHostTests.Route_Cycle_DoesNotHangOrDuplicate;
var
  LVHost: TAMQPVHost;
  LResult: TArray<string>;
begin
  LVHost := TAMQPVHost.Create;
  try
    LVHost.DeclareExchange('exA', AMQP_EXCHANGE_TYPE_FANOUT, True, False,
      False, nil);
    LVHost.DeclareExchange('exB', AMQP_EXCHANGE_TYPE_FANOUT, True, False,
      False, nil);
    LVHost.DeclareQueue('q1', True, False, False, nil);
    LVHost.BindQueue('exA', 'q1', '', nil);
    // cycle: exA -> exB -> exA
    LVHost.BindExchange('exB', 'exA', '', nil);
    LVHost.BindExchange('exA', 'exB', '', nil);

    // If it does not finish, the test runner hangs/overflows -- the test itself
    // running to the end is already part of the assertion.
    LResult := LVHost.Route('exA', 'whatever', nil);
    TAssert.AssertEquals('a cycle does not duplicate the delivery to q1', 1, Length(LResult));
  finally
    LVHost.Free;
  end;
end;

procedure TVHostTests.DeleteQueue_RemovesTheBindings;
var
  LVHost: TAMQPVHost;
  LResult: TArray<string>;
begin
  LVHost := TAMQPVHost.Create;
  try
    LVHost.DeclareExchange('ext', AMQP_EXCHANGE_TYPE_TOPIC, True, False,
      False, nil);
    LVHost.DeclareQueue('q1', True, False, False, nil); // auto-bind no default
    LVHost.BindQueue('ext', 'q1', 'a.#', nil);

    TAssert.AssertTrue('delete', LVHost.DeleteQueue('q1') = amqtrOk);
    TAssert.AssertFalse('queue gone', LVHost.QueueExists('q1'));

    LResult := LVHost.Route('ext', 'a.b', nil);
    TAssert.AssertEquals('the topic binding went with it', 0, Length(LResult));

    LResult := LVHost.Route('', 'q1', nil);
    TAssert.AssertEquals('the auto-bind on the default exchange is gone too', 0,
      Length(LResult));

    TAssert.AssertTrue('delete again -> not found',
      LVHost.DeleteQueue('q1') = amqtrNotFound);
  finally
    LVHost.Free;
  end;
end;

procedure TVHostTests.DeleteExchange_RemovesDanglingBindings;
var
  LVHost: TAMQPVHost;
  LResult: TArray<string>;
begin
  LVHost := TAMQPVHost.Create;
  try
    LVHost.DeclareExchange('exA', AMQP_EXCHANGE_TYPE_FANOUT, True, False,
      False, nil);
    LVHost.DeclareExchange('exB', AMQP_EXCHANGE_TYPE_DIRECT, True, False,
      False, nil);
    LVHost.DeclareQueue('q1', True, False, False, nil);
    LVHost.BindQueue('exB', 'q1', 'rk', nil);
    LVHost.BindExchange('exB', 'exA', 'rk', nil); // exA -> exB

    TAssert.AssertTrue('delete exB', LVHost.DeleteExchange('exB', False) = amqtrOk);

    // The exA->exB binding must not be left pointing at nothing: publishing
    // to exA must neither error nor "find" q1 any more.
    LResult := LVHost.Route('exA', 'rk', nil);
    TAssert.AssertEquals('the dangling binding to exB is gone', 0, Length(LResult));
  finally
    LVHost.Free;
  end;
end;

// --- alternate exchange (WS7 of Phase 3) -----------------------------------

// Builds the declare arguments with alternate-exchange.
function AeArgs(const AName: string): TAMQPFieldTable;
var
  LVal: TValue;
begin
  Result := TAMQPFieldTable.Create;
  LVal := TValue.From<string>(AName);
  Result.Put('alternate-exchange', LVal);
end;

procedure TVHostTests.Ae_ReceivesWhatDidNotMatch;
var
  LVHost: TAMQPVHost;
  LResult: TArray<string>;
begin
  LVHost := TAMQPVHost.Create;
  try
    LVHost.DeclareExchange('ae', AMQP_EXCHANGE_TYPE_FANOUT, True, False,
      False, nil);
    LVHost.DeclareExchange('ex', AMQP_EXCHANGE_TYPE_DIRECT, True, False,
      False, AeArgs('ae'));
    LVHost.DeclareQueue('q.normal', True, False, False, nil);
    LVHost.DeclareQueue('q.ae', True, False, False, nil);
    LVHost.BindQueue('ex', 'q.normal', 'right', nil);
    LVHost.BindQueue('ae', 'q.ae', '', nil);

    LResult := LVHost.Route('ex', 'right', nil);
    TAssert.AssertEquals('matched: goes the normal route', 1, Length(LResult));
    TAssert.AssertEquals('q.normal', LResult[0]);

    LResult := LVHost.Route('ex', 'matches-nothing', nil);
    TAssert.AssertEquals('no match: goes to the AE', 1, Length(LResult));
    TAssert.AssertEquals('q.ae', LResult[0]);
  finally
    LVHost.Free;
  end;
end;

// The AE fires when NO BINDING OF THIS exchange matched -- not when the
// final result came out empty. Here a binding of 'ex' MATCHES and leads to 'meio',
// which has no binding at all: the result is empty, but the AE of 'ex' must NOT
// fire, because 'ex' routed. The one that failed to route was 'meio'.
procedure TVHostTests.Ae_DoesNotFireIfABindingMatched;
var
  LVHost: TAMQPVHost;
  LResult: TArray<string>;
begin
  LVHost := TAMQPVHost.Create;
  try
    LVHost.DeclareExchange('ae', AMQP_EXCHANGE_TYPE_FANOUT, True, False,
      False, nil);
    LVHost.DeclareExchange('middle', AMQP_EXCHANGE_TYPE_FANOUT, True, False,
      False, nil);
    LVHost.DeclareExchange('ex', AMQP_EXCHANGE_TYPE_FANOUT, True, False,
      False, AeArgs('ae'));
    LVHost.DeclareQueue('q.ae', True, False, False, nil);
    LVHost.BindQueue('ae', 'q.ae', '', nil);
    // Exchange.Bind is (DESTINATION, SOURCE): messages from 'ex' go to 'meio'.
    LVHost.BindExchange('middle', 'ex', '', nil);

    LResult := LVHost.Route('ex', 'whatever', nil);
    TAssert.AssertEquals('a binding matched, so the AE of ex stays out', 0,
      Length(LResult));
  finally
    LVHost.Free;
  end;
end;

// AE of an AE: the chain goes down while nobody matches.
procedure TVHostTests.Ae_Chained;
var
  LVHost: TAMQPVHost;
  LResult: TArray<string>;
begin
  LVHost := TAMQPVHost.Create;
  try
    LVHost.DeclareExchange('ae2', AMQP_EXCHANGE_TYPE_FANOUT, True, False,
      False, nil);
    LVHost.DeclareExchange('ae1', AMQP_EXCHANGE_TYPE_DIRECT, True, False,
      False, AeArgs('ae2'));
    LVHost.DeclareExchange('ex', AMQP_EXCHANGE_TYPE_DIRECT, True, False,
      False, AeArgs('ae1'));
    LVHost.DeclareQueue('q.end', True, False, False, nil);
    LVHost.BindQueue('ae2', 'q.end', '', nil);

    LResult := LVHost.Route('ex', 'nothing-matches', nil);
    TAssert.AssertEquals('went down two AE levels', 1, Length(LResult));
    TAssert.AssertEquals('q.end', LResult[0]);
  finally
    LVHost.Free;
  end;
end;

// A cycle through an AE (ex -> ae -> ex) must neither hang nor duplicate: the visited
// set is the same as on the exchange->exchange path.
procedure TVHostTests.Ae_CycleDoesNotHang;
var
  LVHost: TAMQPVHost;
  LResult: TArray<string>;
begin
  LVHost := TAMQPVHost.Create;
