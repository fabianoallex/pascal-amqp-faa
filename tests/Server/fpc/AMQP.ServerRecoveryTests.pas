  LN.VHost := '/';
  LN.Name := AName;
  WriteRecord(AMQP_REC_EXCHANGE_DELETE, AmqpEncodeRecName(LN));
end;

procedure TRecoveryReplayTests.AddContent(AId: UInt64; const ABody: string);
var
  LC: TAMQPRecContent;
begin
  LC.ContentId := AId;
  LC.UserId := 'guest';
  LC.Body := AmqpUtf8Encode(ABody);
  WriteRecord(AMQP_REC_CONTENT, AmqpEncodeRecContent(LC));
end;

procedure TRecoveryReplayTests.AddPlacement(AId, AContent: UInt64;
  const AQueue: string; APriority: Byte);
var
  LE: TAMQPRecEnqueue;
begin
  LE.VHost := '/';
  LE.Queue := AQueue;
  LE.EntryId := AId;
  LE.ContentId := AContent;
  LE.Exchange := '';
  LE.RoutingKey := AQueue;
  LE.Priority := APriority;
  LE.EnqueuedAtWall := 1700000000000;
  LE.TtlMs := -1;
  LE.HeaderPayload := nil;
  WriteRecord(AMQP_REC_ENQUEUE, AmqpEncodeRecEnqueue(LE));
end;

procedure TRecoveryReplayTests.RetirePlacement(AId: UInt64; const AQueue: string);
var
  LD: TAMQPRecDequeue;
begin
  LD.VHost := '/';
  LD.Queue := AQueue;
  LD.EntryId := AId;
  WriteRecord(AMQP_REC_DEQUEUE, AmqpEncodeRecDequeue(LD));
end;

function TRecoveryReplayTests.ReplayLog: TAMQPRecoveredState;
begin
  FJournal.Stop;
  FreeAndNil(FJournal);
  Result := AmqpReplayWal(FDir);
end;

procedure TRecoveryReplayTests.SetUp;
begin
  Inc(GRecSeq);
  FDir := IncludeTrailingPathDelimiter(TempDir) + 'amqprec-'
    + IntToStr(GRecSeq);
  ForceDirectories(FDir);
  ClearRecDir(FDir);
  FJournal := TAMQPJournal.Create(FDir);
  FJournal.Start;
end;

procedure TRecoveryReplayTests.TearDown;
begin
  if FJournal <> nil then
  begin
    try
      FJournal.Stop;
    except
    end;
    FreeAndNil(FJournal);
  end;
  ClearRecDir(FDir);
end;

procedure TRecoveryReplayTests.EmptyLog_EmptyState;
var
  E: TAMQPRecoveredState;
begin
  E := ReplayLog;
  try
    CheckInt('no exchange', 0, E.Exchanges.Count);
    CheckInt('no queue', 0, E.Queues.Count);
    CheckInt('no placement', 0, E.Entries.Count);
    CheckInt('highest id', 0, Integer(E.MaxId));
  finally
    E.Free;
  end;
end;

procedure TRecoveryReplayTests.DurableTopology_Survives;
var
  E: TAMQPRecoveredState;
begin
  MakeExchange('ex.a', 'direct');
  MakeQueue('q.a');
  MakeBinding('ex.a', 'q.a', 'rk');
  E := ReplayLog;
  try
    CheckInt('one exchange', 1, E.Exchanges.Count);
    CheckStr('exchange name', 'ex.a', E.Exchanges[0].Name);
    CheckStr('exchange type', 'direct', E.Exchanges[0].ExchangeType);
    CheckInt('one queue', 1, E.Queues.Count);
    CheckStr('queue name', 'q.a', E.Queues[0].Name);
    CheckInt('one binding', 1, E.Bindings.Count);
    CheckStr('routing key', 'rk', E.Bindings[0].Binding.RoutingKey);
    CheckNot('and the destination is a QUEUE', E.Bindings[0].DestinationIsExchange);
  finally
    E.Free;
  end;
end;

procedure TRecoveryReplayTests.Redeclare_TheLastOneWins;
var
  E: TAMQPRecoveredState;
begin
  // Redeclaring does not duplicate: the log is of operations, the state is the final one.
  MakeQueue('q.a');
  MakeQueue('q.a', True);
  E := ReplayLog;
  try
    CheckInt('one queue, not two', 1, E.Queues.Count);
    CheckOk('and with the auto-delete of the LAST declare', E.Queues[0].AutoDelete);
  finally
    E.Free;
  end;
end;

procedure TRecoveryReplayTests.Unbind_RemovesTheBinding;
var
  E: TAMQPRecoveredState;
begin
  MakeExchange('ex.a', 'direct');
  MakeQueue('q.a');
  MakeBinding('ex.a', 'q.a', 'rk');
  RemoveBinding('ex.a', 'q.a', 'rk');
  E := ReplayLog;
  try
    CheckInt('no binding', 0, E.Bindings.Count);
    CheckInt('but the queue stays', 1, E.Queues.Count);
    CheckInt('and the exchange too', 1, E.Exchanges.Count);
  finally
    E.Free;
  end;
end;

procedure TRecoveryReplayTests.DeletingQueue_TakesBindingsAndPlacements;
var
  E: TAMQPRecoveredState;
begin
  // The test a naive implementation does NOT pass: taking the queue off the list and
  // forgetting the rest would resurrect messages of a queue that no longer exists.
  MakeExchange('ex.a', 'direct');
  MakeQueue('q.a');
  MakeQueue('q.b');
  MakeBinding('ex.a', 'q.a', 'rk');
  MakeBinding('ex.a', 'q.b', 'rk');
  AddContent(1, 'body');
  AddPlacement(2, 1, 'q.a');
  AddPlacement(3, 1, 'q.b');
  RemoveQueue('q.a');
  E := ReplayLog;
  try
    CheckInt('one queue left', 1, E.Queues.Count);
    CheckStr('the one that was not deleted', 'q.b', E.Queues[0].Name);
    CheckInt('one binding left', 1, E.Bindings.Count);
    CheckStr('the one of the live queue', 'q.b', E.Bindings[0].Binding.Destination);
    CheckInt('and a single placement', 1, E.Entries.Count);
    CheckStr('the one of the live queue', 'q.b', E.Entries[0].Queue);
    CheckInt('the other counted as queue-orphaned', 1, E.Stats.OrphanedFromQueue);
  finally
    E.Free;
  end;
end;

procedure TRecoveryReplayTests.DeletingExchange_TakesBindingsFromBothSides;
var
  E: TAMQPRecoveredState;
begin
  // The middle exchange is the DESTINATION of one binding and the SOURCE of another (D5).
  // Looking only at Source would leave the first one orphaned, pointing at what vanished.
  MakeExchange('ex.orig', 'fanout');
  MakeExchange('ex.middle', 'fanout');
  MakeQueue('q.a');
  MakeExchangeBinding('ex.orig', 'ex.middle', '');
  MakeBinding('ex.middle', 'q.a', '');
  RemoveExchange('ex.middle');
  E := ReplayLog;
  try
    CheckInt('one exchange left', 1, E.Exchanges.Count);
    CheckStr('the source one', 'ex.orig', E.Exchanges[0].Name);
    CheckInt('and NO binding: both touched the one that vanished', 0,
      E.Bindings.Count);
    CheckInt('the queue is still standing', 1, E.Queues.Count);
  finally
    E.Free;
  end;
end;

procedure TRecoveryReplayTests.EnqWithoutDeq_StaysAlive;
var
  E: TAMQPRecoveredState;
begin
  // D27 in one line: the DELIVERY is not journaled, so a message
  // delivered and not acked is still a live ENQ and comes back ready.
  MakeQueue('q.a');
  AddContent(1, 'body');
  AddPlacement(2, 1, 'q.a');
  E := ReplayLog;
  try
    CheckInt('one live placement', 1, E.Entries.Count);
    CheckInt('in the counters too', 1, E.Stats.Live);
    CheckInt('nothing retired', 0, E.Stats.Retired);
    CheckStr('the body came along', 'body',
      AmqpUtf8Decode(E.Contents[E.Entries[0].ContentId].Body));
  finally
    E.Free;
  end;
end;

procedure TRecoveryReplayTests.EnqWithDeq_Disappears;
var
  E: TAMQPRecoveredState;
begin
  MakeQueue('q.a');
  AddContent(1, 'body');
  AddPlacement(2, 1, 'q.a');
  RetirePlacement(2, 'q.a');
  E := ReplayLog;
  try
    CheckInt('nothing live', 0, E.Entries.Count);
    CheckInt('one retirement', 1, E.Stats.Retired);
  finally
    E.Free;
  end;
end;

procedure TRecoveryReplayTests.PlacementOrder_IsTheLogOrder;
var
  E: TAMQPRecoveredState;
begin
  // The order of the log IS the enqueue order, and the priority bucket is
  // inside the ENQ -- that is what makes D27 need no extra record at all.
  MakeQueue('q.a');
  AddContent(1, 'a');
  AddPlacement(2, 1, 'q.a');
  AddContent(3, 'b');
  AddPlacement(4, 3, 'q.a');
  AddContent(5, 'c');
  AddPlacement(6, 5, 'q.a');
  RetirePlacement(4, 'q.a'); // the middle one goes
  E := ReplayLog;
  try
    CheckInt('two live ones', 2, E.Entries.Count);
    CheckStr('1st: the oldest', 'a',
      AmqpUtf8Decode(E.Contents[E.Entries[0].ContentId].Body));
    CheckStr('2nd: the newest', 'c',
      AmqpUtf8Decode(E.Contents[E.Entries[1].ContentId].Body));
  finally
    E.Free;
  end;
end;

procedure TRecoveryReplayTests.OneContentTwoPlacements;
var
  E: TAMQPRecoveredState;
begin
  // The payoff of D22, on the read side: a fan-out to N queues has ONE
  // body in the file and N placements pointing at it.
  MakeQueue('q.a');
  MakeQueue('q.b');
  AddContent(1, 'body');
  AddPlacement(2, 1, 'q.a');
  AddPlacement(3, 1, 'q.b');
  E := ReplayLog;
  try
    CheckInt('two placements', 2, E.Entries.Count);
    CheckInt('a single content', 1, E.Contents.Count);
    CheckOk('and both point to it',
      (E.Entries[0].ContentId = 1) and (E.Entries[1].ContentId = 1));
  finally
    E.Free;
  end;
end;

procedure TRecoveryReplayTests.ContentWithoutLivePlacement_IsReleased;
var
  E: TAMQPRecoveredState;
begin
  // Without this, recovery would load into memory the body of EVERY message
  // the broker has ever seen -- the log is append-only, the bodies stay there.
  MakeQueue('q.a');
  AddContent(1, 'consumed');
  AddPlacement(2, 1, 'q.a');
  RetirePlacement(2, 'q.a');
  AddContent(3, 'live');
  AddPlacement(4, 3, 'q.a');
  E := ReplayLog;
  try
    CheckInt('one live placement', 1, E.Entries.Count);
    CheckInt('and ONE content, not two', 1, E.Contents.Count);
    CheckOk('the one left belongs to the live one', E.Contents.ContainsKey(3));
    CheckNot('the consumed one was released', E.Contents.ContainsKey(1));
  finally
    E.Free;
  end;
end;

procedure TRecoveryReplayTests.MaxId_IsTheLargestSeen;
var
  E: TAMQPRecoveredState;
begin
  // If the engine's counter restarted from zero, a new placement would collide
  // with a recovered one, and the DEQ of one would retire the other. Silent and fatal.
  MakeQueue('q.a');
  AddContent(7, 'x');
  AddPlacement(9, 7, 'q.a');
  RetirePlacement(9, 'q.a'); // retired, but the id HAS ALREADY BEEN USED
  // The highest id may be in a CONTENT and not in an ENQ -- both come out of the SAME
  // engine counter. Looking only at the placements would let this one slip.
  AddContent(20, 'y');
  AddPlacement(12, 20, 'q.a');
  E := ReplayLog;
  try
    CheckInt('one live', 1, E.Entries.Count);
    CheckInt('and the highest id is the CONTENT id, not the placement id', 20,
      Integer(E.MaxId));
  finally
    E.Free;
  end;
end;

procedure TRecoveryReplayTests.DeadlineAndPriority_ArriveIntact;
var
  E: TAMQPRecoveredState;
begin
  // D21: the replay does NOT decide the deadline. It hands over the wall-clock instant
  // and the TTL as they are, and whoever holds the live queue rebuilds the monotonic one.
  MakeQueue('q.a');
  AddContent(1, 'x');
  AddPlacement(2, 1, 'q.a', 5);
  E := ReplayLog;
  try
    CheckInt('the priority came', 5, Integer(E.Entries[0].Priority));
    CheckOk('and the wall-clock instant too',
      E.Entries[0].EnqueuedAtWall = 1700000000000);
  finally
    E.Free;
  end;
end;

procedure TRecoveryReplayTests.TornTail_ReplaysThePrefix;
var
  E: TAMQPRecoveredState;
  LWalFile: string;
  LStream: TFileStream;
  LSegs: TArray<Cardinal>;
begin
  // The NORMAL case after a crash, not an error (D23). The valid prefix
  // is exactly what recovery replays.
  MakeQueue('q.a');
  AddContent(1, 'a');
  AddPlacement(2, 1, 'q.a');
  AddContent(3, 'b');
  AddPlacement(4, 3, 'q.a');
  FJournal.Stop;
  FreeAndNil(FJournal);

  // Cuts off the last bytes: the final record is left half-written. The segment
  // NUMBER comes from the listing, not from a literal: the journal starts at 1, and
  // guessing the name would make the test fail for the wrong reason.
  LSegs := AmqpWalListSegments(FDir);
  CheckInt('one segment', 1, Length(LSegs));
  LWalFile := IncludeTrailingPathDelimiter(FDir) + AmqpWalSegmentName(LSegs[0]);
  LStream := TFileStream.Create(LWalFile, fmOpenReadWrite or fmShareDenyNone);
  try
    LStream.Size := LStream.Size - 12;
  finally
    LStream.Free;
  end;

  E := AmqpReplayWal(FDir);
  try
    CheckNot('the read did NOT reach the end intact', E.Stats.StopReason = awsEnd);
    CheckInt('the queue from the prefix survived', 1, E.Queues.Count);
    // The last placement fell with the tail; the first one is still there.
    CheckInt('one live placement', 1, E.Entries.Count);
    CheckStr('the one from the prefix', 'a',
      AmqpUtf8Decode(E.Contents[E.Entries[0].ContentId].Body));
  finally
    E.Free;
  end;
end;

{ --- segment rotation (WS7 of Phase 4, D26) --- }

procedure TRecoveryReplayTests.Rotate_WhenTheSegmentFills;
var
  I: Integer;
  LLast: UInt64;
begin
  // A tiny cap so rotation happens with few records: the real value
  // (16 MB) only makes the test slow, not more true.
  FJournal.MaxSegmentBytes := 600;
  MakeQueue('q.a');
  for I := 1 to 40 do
    LLast := WriteRecord(AMQP_REC_CONTENT,
      AmqpEncodeRecContent(ContentRecord(I, 'value-' + IntToStr(I))));
  // BARRIER: Submit only ENQUEUES -- whoever writes (and whoever rotates) is the
  // journal thread. Without waiting for the watermark, the test would look at the segment
  // before the first byte had gone out.
  CheckOk('the batch became durable', FJournal.WaitDurable(LLast, 5000));
  // Rotation runs AFTER the watermark advances (batch boundary, after the
  // fsync -- D24), and Rotate opens the new segment before counting the rotation.
  // So WaitDurable is not a barrier for either of the two reads: it waits
  // with a deadline. Without this the test failed on Linux with the machine under load (F8):
  // ActiveSegment was already 2 and Rotations still 0.
  I := 0;
  while ((FJournal.ActiveSegment <= 1) or (FJournal.Stats.Rotations < 1))
    and (I < 500) do
  begin
    Sleep(10);
    Inc(I);
  end;
  CheckOk('the active segment moved past the first',
    FJournal.ActiveSegment > 1);
  CheckOk('and the rotations were counted',
    FJournal.Stats.Rotations >= 1);
end;

procedure TRecoveryReplayTests.Rotate_DoesNotSplitABatchAcrossTwoFiles;
var
  LRecs: TAMQPJournalRecords;
  LSegs: TArray<Cardinal>;
  I, LFound: Integer;
  LWalRecords: TAMQPWalRecords;
  LStop: TAMQPWalStop;
  LWalFile: IAMQPWalFile;
  LSeg: TAMQPWalSegment;
  LN: Integer;
begin
  // THE INVARIANT ROTATION MUST NOT BREAK: the batch is indivisible (D24).
  // Splitting it across two files would give an ARTIFICIAL broken tail in the first,
  // and recovery would drop half of a publish that has already been accepted.
  //
  // THE NUMBERS ARE CHOSEN TO FORCE THE WINDOW, and not by chance: an
  // earlier version of this test used two small records and a cap of 500, and
  // the "rotates in the middle of the batch" MUTATION SURVIVED -- with records of the same
  // size the cut point always falls in the same place, and by luck it was even.
  // Here the FIRST record of the pair already overflows the cap on its own: if rotation
  // looked at the size on every record, it would split EVERY pair, and the count of
  // each segment would come out odd.
  //
  // The WaitDurable between submits keeps each batch at exactly two records
  // (without it group commit would put everything into a single batch).
  FJournal.MaxSegmentBytes := 300;
  SetLength(LRecs, 2);
  for I := 1 to 8 do
  begin
    LRecs[0].Kind := AMQP_REC_CONTENT;
    LRecs[0].Payload := AmqpEncodeRecContent(
      ContentRecord(I * 2 - 1, StringOfChar('a', 400)));
    LRecs[1].Kind := AMQP_REC_CONTENT;
    LRecs[1].Payload := AmqpEncodeRecContent(ContentRecord(I * 2, 'b'));
    CheckOk('the batch became durable',
      FJournal.WaitDurable(FJournal.Submit(LRecs), 5000));
  end;
  FJournal.Stop;
  FreeAndNil(FJournal);

  LSegs := AmqpWalListSegments(FDir);
  CheckOk('it did rotate', Length(LSegs) > 1);
  LFound := 0;
  for I := 0 to High(LSegs) do
  begin
    LWalFile := TAMQPWalOsFile.Create(
      IncludeTrailingPathDelimiter(FDir) + AmqpWalSegmentName(LSegs[I]), False);
    LSeg := TAMQPWalSegment.OpenExisting(LWalFile, False);
    try
      LN := LSeg.ReadPrefix(LWalRecords, LStop);
      Inc(LFound, LN);
      CheckInt('no segment ends with half a batch (segment '
        + IntToStr(LSegs[I]) + ')', 0, LN mod 2);
    finally
      LSeg.Free;
      LWalFile := nil;
    end;
  end;
  CheckInt('and no record was lost in the switch', 16, LFound);
end;

procedure TRecoveryReplayTests.Rotate_LsnContinuesAcrossSegments;
var
  I: Integer;
  LLast, LAfter: UInt64;
begin
  // The LSN belongs to the JOURNAL, not to the file. If it restarted on each segment, the
  // increasing-LSN invariant of WS1 would refuse the first append of the new
  // segment -- and, worse, if it did not refuse, recovery would read a log in which the LSN
  // goes backwards in the middle.
  //
  // THE SUBMIT HAS TO COME AFTER THE ROTATION. An earlier version of this test
  // measured the LSN of 40 submits made BEFORE the journal thread wrote
  // anything -- the LSNs had all been assigned already, and the mutation that
  // zeroed the counter on rotation SURVIVED. Here the rotation happens (with a
  // barrier), and only then is the next number asked for.
  FJournal.MaxSegmentBytes := 600;
  LLast := 0;
  for I := 1 to 40 do
    LLast := WriteRecord(AMQP_REC_CONTENT,
      AmqpEncodeRecContent(ContentRecord(I, 'x')));
  CheckOk('the batch became durable', FJournal.WaitDurable(LLast, 5000));
  CheckOk('rotated', FJournal.ActiveSegment > 1);

  LAfter := WriteRecord(AMQP_REC_CONTENT, AmqpEncodeRecContent(ContentRecord(99, 'y')));
  CheckOk('the record after the rotation became durable',
    FJournal.WaitDurable(LAfter, 5000));
  CheckOk('the LSN CONTINUED across the rotation instead of restarting',
    LAfter > LLast);
end;

procedure TRecoveryReplayTests.Rotate_ReplayReadsAllSegmentsAsOneLog;
var
  E: TAMQPRecoveredState;
  I: Integer;
begin
  // Recovery already walked the list of segments (WS6); this test is
  // what ties the two WSs together: with rotation on, the state has to come out
  // IDENTICAL to that of a single-file log.
  FJournal.MaxSegmentBytes := 700;
  MakeQueue('q.a');
  for I := 1 to 20 do
  begin
    AddContent(I * 2 - 1, 'value-' + IntToStr(I));
    AddPlacement(I * 2, I * 2 - 1, 'q.a');
  end;
  E := ReplayLog;
  try
    CheckOk('read more than one segment', E.Stats.Segments > 1);
    CheckInt('the queue came', 1, E.Queues.Count);
    CheckInt('and the 20 placements too', 20, E.Entries.Count);
    CheckStr('in log order, from the first', 'value-1',
      AmqpUtf8Decode(E.Contents[E.Entries[0].ContentId].Body));
    CheckStr('the' + ' last', 'value-20',
      AmqpUtf8Decode(E.Contents[E.Entries[19].ContentId].Body));
  finally
    E.Free;
  end;
end;

procedure TRecoveryReplayTests.Rotate_ReopenContinuesInTheLastSegment;
var
  I: Integer;
  LSegAfter: Cardinal;
  LLast: UInt64;
begin
  // A restart must not go back to writing into the FIRST segment: it would overwrite
  // live records. The journal reopens on the LAST one, which is the active one.
  FJournal.MaxSegmentBytes := 600;
  for I := 1 to 40 do
    LLast := WriteRecord(AMQP_REC_CONTENT,
      AmqpEncodeRecContent(ContentRecord(I, 'x')));
  CheckOk('the batch became durable', FJournal.WaitDurable(LLast, 5000));
  LSegAfter := FJournal.ActiveSegment;
  CheckOk('rotated before closing', LSegAfter > 1);
  FJournal.Stop;
  FreeAndNil(FJournal);

  FJournal := TAMQPJournal.Create(FDir);
  FJournal.Start;
  CheckInt('reopened on the last segment, not the first',
    Integer(LSegAfter), Integer(FJournal.ActiveSegment));
end;

{ --- compaction (WS7 of Phase 4, D26) --- }

procedure TRecoveryReplayTests.Compact_ShrinksTheLogWithoutChangingState;
var
  E: TAMQPRecoveredState;
  I: Integer;
  LBefore, LAfter: Int64;
begin
  // What compaction promises: FEWER BYTES, SAME STATE. Publishes 30 and
  // retires 28 -- it is the case D26 describes, a large log and small live
  // content.
  MakeQueue('q.a');
  for I := 1 to 30 do
  begin
    AddContent(I * 2 - 1, 'value-' + IntToStr(I));
    AddPlacement(I * 2, I * 2 - 1, 'q.a');
  end;
  for I := 1 to 28 do
    RetirePlacement(I * 2, 'q.a');
  CheckOk('everything durable',
    FJournal.WaitDurable(FJournal.Stats.NextLsn - 1, 5000));
  LBefore := FJournal.TotalSize;

  CheckOk('compacted', FJournal.Compact);
  LAfter := FJournal.TotalSize;
  CheckOk('the log shrank', LAfter < LBefore);

  E := ReplayLog;
  try
    CheckInt('the queue is still there', 1, E.Queues.Count);
    CheckInt('and the two live ones too', 2, E.Entries.Count);
    CheckStr('the first live one is number 29', 'value-29',
      AmqpUtf8Decode(E.Contents[E.Entries[0].ContentId].Body));
    CheckInt('and the content of the retired ones is gone', 2, E.Contents.Count);
  finally
    E.Free;
  end;
end;

procedure TRecoveryReplayTests.Compact_DeletesTheOldSegments;
var
  I: Integer;
  LLsn: UInt64;
  LSegsBefore, LSegsAfter: TArray<Cardinal>;
begin
  // ONE BARRIER PER RECORD, and not one at the end. Group commit puts everything
  // in the queue into a single batch, and rotation happens at the BATCH
  // BOUNDARY -- so 60 submits in a burst can become ONE batch and ONE rotation, and the
  // number of segments comes to depend on who runs faster, the test
  // loop or the journal thread. That is what happened: green on FPC, red
  // on Delphi. Waiting for each record to become durable, each one is its own
  // batch and the segment count becomes a function of size, not of the scheduler.
  FJournal.MaxSegmentBytes := 300;
  MakeQueue('q.a');
  for I := 1 to 30 do
  begin
    LLsn := WriteRecord(AMQP_REC_CONTENT,
      AmqpEncodeRecContent(ContentRecord(I, 'value-' + IntToStr(I))));
    CheckOk('durable record', FJournal.WaitDurable(LLsn, 5000));
  end;
  LSegsBefore := AmqpWalListSegments(FDir);
  CheckOk('there were several segments', Length(LSegsBefore) > 2);

  CheckOk('compacted', FJournal.Compact);
  LSegsAfter := AmqpWalListSegments(FDir);
  // No live placement (only loose content, which nobody references): what is left is
  // the new segment with the topology and nothing else.
  CheckInt('ONE segment left', 1, Length(LSegsAfter));
  CheckOk('and it is newer than all the deleted ones',
    LSegsAfter[0] > LSegsBefore[High(LSegsBefore)]);
  CheckOk('the deleted ones were counted',
    FJournal.Stats.DeletedSegments >= Length(LSegsBefore));
end;

procedure TRecoveryReplayTests.Compact_PreservesTheIdentifiers;
var
  E: TAMQPRecoveredState;
begin
  // THE IDENTIFIERS ARE WHAT MAKES THE REWRITE IDEMPOTENT. If
  // compaction renumbered, a log with both copies (a crash between writing the
  // new one and deleting the old one) would describe TWO messages instead of one.
  MakeQueue('q.a');
  AddContent(7, 'x');
  AddPlacement(9, 7, 'q.a');
  CheckOk('everything durable',
    FJournal.WaitDurable(FJournal.Stats.NextLsn - 1, 5000));
  CheckOk('compacted', FJournal.Compact);
  E := ReplayLog;
  try
    CheckInt('one placement', 1, E.Entries.Count);
    CheckInt('with the SAME EntryId as before', 9, Integer(E.Entries[0].EntryId));
    CheckInt('and the SAME ContentId', 7, Integer(E.Entries[0].ContentId));
  finally
    E.Free;
  end;
end;

procedure TRecoveryReplayTests.Compact_DoesNotDuplicateIfTheOldOnesRemain;
var
  E: TAMQPRecoveredState;
  LEnq: TAMQPRecEnqueue;
  LContentRec: TAMQPRecContent;
  LLsn: UInt64;
begin
  // THE CRASH BETWEEN STEP 4 AND 5, simulated: the new segment is already on
  // disk and the old one has not been deleted yet. It is the only point at which
  // compaction can be interrupted without the fsync having decided, and the resulting
  // log has to describe ONE message, not two.
  //
  // Instead of bringing down the process (which does not test fsync, D28), I build the
  // situation by hand: I write the SAME placement twice, which is exactly the
  // file an interrupted compaction would leave behind.
  MakeQueue('q.a');
  AddContent(5, 'single');
  AddPlacement(6, 5, 'q.a');
  LContentRec.ContentId := 5;
  LContentRec.UserId := 'guest';
  LContentRec.Body := AmqpUtf8Encode('single');
  LEnq.VHost := '/';
  LEnq.Queue := 'q.a';
  LEnq.EntryId := 6;      // The SAME id
  LEnq.ContentId := 5;
  LEnq.Exchange := '';
  LEnq.RoutingKey := 'q.a';
  LEnq.Priority := 0;
  LEnq.EnqueuedAtWall := 1700000000000;
  LEnq.TtlMs := -1;
  LEnq.HeaderPayload := nil;
  WriteRecord(AMQP_REC_CONTENT, AmqpEncodeRecContent(LContentRec));
  LLsn := WriteRecord(AMQP_REC_ENQUEUE, AmqpEncodeRecEnqueue(LEnq));
  CheckOk('everything durable', FJournal.WaitDurable(LLsn, 5000));

  E := ReplayLog;
  try
    CheckInt('ONE placement, not two', 1, E.Entries.Count);
    CheckInt('and the repeated one was counted', 1, E.Stats.Duplicates);
  finally
    E.Free;
  end;
end;

procedure TRecoveryReplayTests.Compact_PreservesOrderAndDeadlines;
var
  E: TAMQPRecoveredState;
begin
  // The rewritten record has to come out equal field by field: if compaction
  // lost the wall-clock instant or the bucket, the message would come back from the restart
  // with a renewed deadline (D21) or at the wrong priority (D12) -- and no
  // "the message survived" test would notice.
  MakeQueue('q.a');
  AddContent(1, 'first');
  AddPlacement(2, 1, 'q.a', 3);
  AddContent(3, 'second');
  AddPlacement(4, 3, 'q.a', 7);
  CheckOk('everything durable',
    FJournal.WaitDurable(FJournal.Stats.NextLsn - 1, 5000));
  CheckOk('compacted', FJournal.Compact);
  E := ReplayLog;
  try
    CheckInt('both', 2, E.Entries.Count);
    CheckStr('in the original log order', 'first',
      AmqpUtf8Decode(E.Contents[E.Entries[0].ContentId].Body));
    CheckInt('with the priority of the first', 3, Integer(E.Entries[0].Priority));
    CheckInt('and that of the second', 7, Integer(E.Entries[1].Priority));
    CheckOk('and the wall-clock instant intact',
      E.Entries[0].EnqueuedAtWall = 1700000000000);
  finally
    E.Free;
  end;
end;

procedure TRecoveryReplayTests.Compact_WholeLogDead_NoPlacementLeft;
var
  E: TAMQPRecoveredState;
  I: Integer;
begin
  MakeQueue('q.a');
  for I := 1 to 10 do
  begin
    AddContent(I * 2 - 1, 'x');
    AddPlacement(I * 2, I * 2 - 1, 'q.a');
    RetirePlacement(I * 2, 'q.a');
  end;
  CheckOk('everything durable',
    FJournal.WaitDurable(FJournal.Stats.NextLsn - 1, 5000));
  CheckOk('compacted', FJournal.Compact);
  E := ReplayLog;
  try
    CheckInt('no placement', 0, E.Entries.Count);
    CheckInt('no content', 0, E.Contents.Count);
    CheckInt('but the TOPOLOGY stays -- it does not die with the messages', 1,
      E.Queues.Count);
  finally
    E.Free;
  end;
end;

procedure TRecoveryReplayTests.Compact_OnStart_WhenTheLogExceedsTheThreshold;
var
  I: Integer;
  LLsn: UInt64;
  LBefore, LAfter: Int64;
  J: TAMQPJournal;
begin
  // Compaction ONLY runs with the journal quiescent -- today, inside Start.
  // There is no in-flight trigger, and the reason is in the header of AMQP.Server.Journal:
  // the LSN is assigned in Submit, and compaction assigns NEW LSNs; a
  // publish that took its LSN before and is still in the queue would be written
  // AFTER, with a lower LSN, and Append would refuse it. The previous version of this test
  // fired compaction on rotation and it was that version that uncovered the defect.
  //
  // Here, the equivalent of Start: writes, closes the journal, reopens and compacts
  // with nobody else submitting.
  MakeQueue('q.a');
  for I := 1 to 30 do
  begin
    AddContent(I * 2 - 1, 'value-' + IntToStr(I));
    AddPlacement(I * 2, I * 2 - 1, 'q.a');
    LLsn := WriteRecord(AMQP_REC_DEQUEUE,
      AmqpEncodeRecDequeue(DequeueRecord(I * 2, 'q.a')));
  end;
  CheckOk('everything durable', FJournal.WaitDurable(LLsn, 5000));
  LBefore := FJournal.TotalSize;
  FJournal.Stop;
  FreeAndNil(FJournal);

  J := TAMQPJournal.Create(FDir);
  try
    J.Start;
    CheckOk('the log is above the threshold', J.TotalSize >= 1500);
    CheckOk('compacted', J.Compact);
    LAfter := J.TotalSize;
    CheckOk('and it shrank', LAfter < LBefore);
    CheckOk('deleting a segment', J.Stats.DeletedSegments >= 1);
  finally
    J.Stop;
    J.Free;
  end;
  FJournal := nil;
end;

procedure TRecoveryReplayTests.Compact_FsyncFailed_DeletesNothing;
var
  J: TJournalWithFailingSync;
  LSegsBefore, LSegsAfter: TArray<Cardinal>;
  LRecs: TAMQPJournalRecords;
  I: Integer;
begin
  // THE SAFETY INVARIANT OF COMPACTION: while the fsync of the new segment
  // has not been accepted, the old ones MUST NOT BE DELETED. Erring on the side
  // of a log bigger than necessary is the right mistake to make; erring on the
  // other side deletes the only place where the messages exist.
  //
  // A mutation that removed the Sync check passed the whole suite until
  // this test existed -- in-process, fsync never fails on its own.
  FJournal.Stop;
  FreeAndNil(FJournal);
  J := TJournalWithFailingSync.Create(FDir);
  try
    J.Start;
    J.MaxSegmentBytes := 300;
    SetLength(LRecs, 1);
    for I := 1 to 40 do
    begin
      LRecs[0].Kind := AMQP_REC_CONTENT;
      LRecs[0].Payload := AmqpEncodeRecContent(ContentRecord(I, 'x'));
      J.Submit(LRecs);
    end;
    CheckOk('everything durable', J.WaitDurable(J.Stats.NextLsn - 1, 5000));
    LSegsBefore := AmqpWalListSegments(FDir);
    CheckOk('there were several segments', Length(LSegsBefore) > 1);

    J.FailTheSync;
    CheckNot('compaction refuses to complete', J.Compact);
    LSegsAfter := AmqpWalListSegments(FDir);
    CheckOk('and NO old segment was deleted',
      Length(LSegsAfter) >= Length(LSegsBefore));
  finally
    try
      J.Stop;
    except
    end;
    J.Free;
  end;
  // TearDown expects FJournal <> nil or nil; it has already been freed above
  FJournal := nil;
end;

procedure TRecoveryReplayTests.Compact_FanOut_WritesTheBodyOnlyOnce;
var
  LSegs: TArray<Cardinal>;
  LWalFile: IAMQPWalFile;
  LSeg: TAMQPWalSegment;
  LWalRecords: TAMQPWalRecords;
  LStop: TAMQPWalStop;
  LN, I, J, LContents, LPlacements: Integer;
begin
  // THE PAYOFF OF D22, on the compaction side: a fan-out to three queues has
  // ONE body and THREE placements. If the rewrite wrote the body per placement,
  // the state would come out the same -- and the log three times bigger, which is exactly what
  // compaction exists to avoid. No state test notices.
  MakeQueue('q.a');
  MakeQueue('q.b');
  MakeQueue('q.c');
  AddContent(1, 'shared');
  AddPlacement(2, 1, 'q.a');
  AddPlacement(3, 1, 'q.b');
  AddPlacement(4, 1, 'q.c');
  CheckOk('everything durable',
    FJournal.WaitDurable(FJournal.Stats.NextLsn - 1, 5000));
  CheckOk('compacted', FJournal.Compact);
  FJournal.Stop;
  FreeAndNil(FJournal);

  LContents := 0;
  LPlacements := 0;
  LSegs := AmqpWalListSegments(FDir);
  for I := 0 to High(LSegs) do
  begin
    LWalFile := TAMQPWalOsFile.Create(
      IncludeTrailingPathDelimiter(FDir) + AmqpWalSegmentName(LSegs[I]), False);
    LSeg := TAMQPWalSegment.OpenExisting(LWalFile, False);
    try
      LN := LSeg.ReadPrefix(LWalRecords, LStop);
      for J := 0 to LN - 1 do
        if LWalRecords[J].Kind = AMQP_REC_CONTENT then
          Inc(LContents)
        else if LWalRecords[J].Kind = AMQP_REC_ENQUEUE then
          Inc(LPlacements);
    finally
      LSeg.Free;
      LWalFile := nil;
    end;
  end;
  CheckInt('ONE content record in the compacted log', 1, LContents);
  CheckInt('and three placements', 3, LPlacements);
end;

{ --- hard cap on the log (WS7 of Phase 4, D26) --- }

procedure TRecoveryReplayTests.Cap_ZeroIsUnlimited;
var
  I: Integer;
  LLsn: UInt64;
begin
  // 0 = unlimited, the shape of D7's MaxQueueLength. It is the DEFAULT: nobody
  // gets a disk cap for having turned durability on.
  CheckInt('the default is zero', 0, Integer(FJournal.MaxJournalBytes));
  for I := 1 to 40 do
    LLsn := WriteRecord(AMQP_REC_CONTENT,
      AmqpEncodeRecContent(ContentRecord(I, StringOfChar('x', 200))));
  CheckOk('everything durable', FJournal.WaitDurable(LLsn, 5000));
  CheckNot('and the journal never declares itself full', FJournal.IsFull);
end;

procedure TRecoveryReplayTests.Cap_Exceeded_SetsFull;
var
  I: Integer;
  LLsn: UInt64;
begin
  FJournal.MaxJournalBytes := 2000;
  CheckNot('starts empty', FJournal.IsFull);
  for I := 1 to 40 do
    LLsn := WriteRecord(AMQP_REC_CONTENT,
      AmqpEncodeRecContent(ContentRecord(I, StringOfChar('x', 200))));
  CheckOk('everything durable', FJournal.WaitDurable(LLsn, 5000));
  CheckOk('went over the cap and declares itself full', FJournal.IsFull);
  CheckOk('and the reported size matches the cap',
    FJournal.Stats.Bytes >= 2000);
end;

procedure TRecoveryReplayTests.Cap_RetirementIsNeverRefused;
var
  I: Integer;
  LLsn: UInt64;
  E: TAMQPRecoveredState;
begin
  // THE RULE THAT SAVES THE BROKER FROM LOCKING ITSELF UP: the cap applies to the
  // PUBLISHER's path. The RETIREMENT record always goes through -- besides D24 forbidding
  // blocking the actor, refusing a DEQ would resurrect the message on the next boot, and
  // it is precisely the DEQs that let compaction shrink the log and GET OUT
  // of this situation. Refusing them would be closing the only door.
  MakeQueue('q.a');
  AddContent(1, 'x');
  AddPlacement(2, 1, 'q.a');
  FJournal.MaxJournalBytes := 1; // full from the start
  CheckOk('full', FJournal.IsFull);
  LLsn := FJournal.SubmitNoWait(JournalRecordsOf(AMQP_REC_DEQUEUE,
    AmqpEncodeRecDequeue(DequeueRecord(2, 'q.a'))));
  CheckOk('the DEQ was accepted even with the log full', LLsn > 0);
  CheckOk('and became durable', FJournal.WaitDurable(LLsn, 5000));
  E := ReplayLog;
  try
    CheckInt('the placement was indeed retired', 0, E.Entries.Count);
  finally
    E.Free;
  end;
end;

initialization
  RegisterTest(TRecoveryReplayTests);

end.
