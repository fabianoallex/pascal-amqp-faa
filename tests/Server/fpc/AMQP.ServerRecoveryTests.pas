  LN.VHost := '/';
  LN.Name := AName;
  WriteRecord(AMQP_REC_QUEUE_DELETE, AmqpEncodeRecName(LN));
end;

procedure TRecoveryReplayTests.RemoveExchange(const AName: string);
var
  LN: TAMQPRecName;
