  LQ: TAMQPRecQueue;
begin
  LQ.VHost := '/';
  LQ.Name := AName;
  LQ.Durable := True;
  LQ.AutoDelete := AAutoDelete;
  LQ.Arguments := nil;
  WriteRecord(AMQP_REC_QUEUE_DECLARE, AmqpEncodeRecQueue(LQ));
end;

