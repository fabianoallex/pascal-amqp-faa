unit AMQP.OutboxAmqpTests;

{ Tests for AMQP.Outbox (src/outbox, the bridge to pascal-db-faa's outbox):
  the sink and the consumer against this library's embedded broker
  (TAMQPServer, an ephemeral port on 127.0.0.1), with the database a SQLite
  file in the temporary directory (AMQP.OutboxTestDb). No RabbitMQ.

  The consumer's callbacks run on the library's threads, so a test waits for
  what it expects (a count reached, a queue empty) with a deadline, never a
  fixed sleep.

  From pascal-agenda-faa's Agenda.OutboxAmqpTests, plus the clock test.

  DUnitX master. The FPCUnit mirror (tests/Outbox/fpc) is generated by
  tools/gen_fpc_mirror.py; never edit the mirror by hand. }

interface

uses
  DUnitX.TestFramework,
  AMQP.DUnitXCompat,
  SysUtils,
  PascalDb.Interfaces,
  PascalDb.Outbox,
  AMQP.Connection,
  AMQP.Server.Broker,
  AMQP.Outbox,
  AMQP.OutboxTestDb;

type
  [TestFixture]
  TOutboxTests = class
  private
    FDb: TOutboxTestDb;
    FBroker: TAMQPServer;
    FConnection: TAMQPConnection;
    FChannel: TAMQPChannel;
    FQueue: TOutboxAmqpQueue;
    FErrors: Integer;
    function Event(const AId, AKind: string): TOutboxEvent;
    procedure CountError(const AEvent: TOutboxEvent; const AHandler, AMessage: string);
  public
    [Setup] procedure SetUp;
    [TearDown] procedure TearDown;
    [Test] procedure Sink_PublishesTheEvent_Confirmed;
    [Test] procedure Consumer_HandlesOnce_ThenRecorded;
    [Test] procedure Consumer_Redelivered_NotRunAgain;
    [Test] procedure Consumer_FailsOnce_RetriedFromTheRetryQueue;
    [Test] procedure Consumer_FailsAlways_ParkedAfterTheTries;
    [Test] procedure Consumer_OtherKind_AckedNotRun;
    [Test] procedure PurgeProcessed_ByAge;
    [Test] procedure Consumer_RecordsTheTimeOfTClock;
  end;

implementation

uses
  DateUtils,
  PascalCommon.Threading,
  PascalCommon.SystemContext,
  PascalCommon.Metrics,
  AMQP.Queue.Methods;

const
  TENANT = 'demo';
  EXCHANGE = 'outbox.test';
  WAIT_MS = 10000;

// A metric's value now in PcMetrics: a counter's or a gauge's series
// with these label values, 0 when the series doesn't exist yet. The
// registry is the process's, so the tests compare before and after.
function MetricValue(const AName: string; const ALabels: array of string): Double;
var
  LMetrics: TPcMetricList;
  LPoints: TPcMetricPoints;
  I, J, K: Integer;
  LSame: Boolean;
begin
  Result := 0;
  LMetrics := PcMetrics.Metrics;
  for I := 0 to High(LMetrics) do
    if LMetrics[I].Name = AName then
    begin
      LPoints := LMetrics[I].Snapshot;
      for J := 0 to High(LPoints) do
      begin
        LSame := Length(LPoints[J].LabelValues) = Length(ALabels);
        if LSame then
          for K := 0 to High(ALabels) do
            if LPoints[J].LabelValues[K] <> ALabels[K] then
              LSame := False;
        if LSame then
          Exit(LPoints[J].Value);
      end;
    end;
end;

type
  /// Accepts one kind; fails FailsLeft times (-1: always). Its counters are
  /// read by the test thread while the consumer's threads write them.
  TTestHandler = class(TInterfacedObject, IOutboxHandler)
  private
    FKind: string;
  public
    FailsLeft: Integer;
    Tries: Integer;
    Handled: Integer;
    constructor Create(const AKind: string; AFails: Integer = 0);
    function Name: string;
    function Accepts(const AKind: string): Boolean;
    procedure Handle(const AEvent: TOutboxEvent);
  end;

  /// A wall clock stopped at one moment (local time, as TClock's).
  TFixedClock = class(TInterfacedObject, IClock)
  private
    FNow: TDateTime;
  public
    constructor Create(ANow: TDateTime);
    function Now: TDateTime;
    function Date: TDateTime;
  end;

constructor TFixedClock.Create(ANow: TDateTime);
begin
  inherited Create;
  FNow := ANow;
end;

function TFixedClock.Now: TDateTime;
begin
  Result := FNow;
end;

function TFixedClock.Date: TDateTime;
begin
  Result := Trunc(FNow);
end;

constructor TTestHandler.Create(const AKind: string; AFails: Integer);
begin
  inherited Create;
  FKind := AKind;
  FailsLeft := AFails;
end;

function TTestHandler.Name: string;
begin
  Result := 'test';
end;

function TTestHandler.Accepts(const AKind: string): Boolean;
begin
  Result := AKind = FKind;
end;

procedure TTestHandler.Handle(const AEvent: TOutboxEvent);
begin
  PcAtomicInc(Tries);
  if PcAtomicGet(FailsLeft) <> 0 then
  begin
    if PcAtomicGet(FailsLeft) > 0 then
      PcAtomicDec(FailsLeft);
    raise Exception.Create('the handler failed');
  end;
  PcAtomicInc(Handled);
end;

// Waits until ACounter reaches AValue; False at the deadline.
function WaitFor(var ACounter: Integer; AValue: Integer): Boolean;
var
  LWaited: Integer;
begin
  LWaited := 0;
  while (PcAtomicGet(ACounter) < AValue) and (LWaited < WAIT_MS) do
  begin
    Sleep(20);
    Inc(LWaited, 20);
  end;
  Result := PcAtomicGet(ACounter) >= AValue;
end;

// Messages ready in AName; the consumer settled what it got when it is 0
// and InFlight is 0.
function Ready(AChannel: TAMQPChannel; const AName: string): Cardinal;
var
  LDeclare: TAMQPQueueDeclare;
begin
  LDeclare := TAMQPQueueDeclare.Create(AName, True);
  LDeclare.Passive := True;
  Result := AChannel.DeclareQueue(LDeclare).MessageCount;
end;

function WaitReady(AChannel: TAMQPChannel; const AName: string; AValue: Cardinal): Boolean;
var
  LWaited: Integer;
begin
  LWaited := 0;
  while (Ready(AChannel, AName) <> AValue) and (LWaited < WAIT_MS) do
  begin
    Sleep(20);
    Inc(LWaited, 20);
  end;
  Result := Ready(AChannel, AName) = AValue;
end;

{ TOutboxTests }

procedure TOutboxTests.SetUp;
var
  LParams: TAMQPConnectionParams;
begin
  FErrors := 0;
  FDb := TOutboxTestDb.Create;
  FBroker := TAMQPServer.Create;
  FBroker.BindAddress := '127.0.0.1';
  FBroker.Port := 0;
  FBroker.Start;
  LParams := TAMQPConnectionParams.Localhost;
  LParams.Host := '127.0.0.1';
  LParams.Port := FBroker.Port;
  FConnection := TAMQPConnection.Create(LParams);
  FConnection.Open;
  FChannel := FConnection.CreateChannel;
  FQueue := TOutboxAmqpQueue.Create('outbox.test.email', EXCHANGE, 'appointment.#');
  FQueue.RetryDelayMs := 100;
  FQueue.MaxAttempts := 3;
  OutboxAmqpDeclareExchange(FChannel, EXCHANGE);
  OutboxAmqpDeclareQueues(FChannel, FQueue);
end;

procedure TOutboxTests.TearDown;
begin
  FreeAndNil(FChannel);
  FreeAndNil(FConnection);
  FreeAndNil(FBroker);
  FreeAndNil(FDb);
end;

function TOutboxTests.Event(const AId, AKind: string): TOutboxEvent;
begin
  Result.TenantId := TENANT;
  Result.Id := AId;
  Result.Kind := AKind;
  Result.Payload := '{"appointmentId":"a1","version":1}';
  Result.TraceParent := '';
  Result.CreatedAt := 1700000000;
  Result.Attempts := 0;
end;

procedure TOutboxTests.CountError(const AEvent: TOutboxEvent; const AHandler,
  AMessage: string);
begin
  PcAtomicInc(FErrors);
end;

procedure TOutboxTests.Sink_PublishesTheEvent_Confirmed;
var
  LSink: IOutboxSink;
  LGet: TAMQPGetResult;
  LEvent: TOutboxEvent;
  LDelivery: TAMQPDelivery;
begin
  LSink := TOutboxAmqpSink.Create(FChannel, EXCHANGE);
  LSink.Deliver(nil, Event('e1', 'appointment.booked'), 1700000001);
  // Not bound: a kind outside the binding key is published and dropped.
  LSink.Deliver(nil, Event('e2', 'other.kind'), 1700000001);
  LGet := FChannel.BasicGet(FQueue.Name, True);
  try
    TAssert.AssertTrue('in the work queue', LGet.Found);
    TAssert.AssertEquals('application/json', LGet.Properties.ContentType);
    TAssert.AssertEquals('persistent', 2, Integer(LGet.Properties.DeliveryMode));
    LDelivery.Properties := LGet.Properties;
    LDelivery.Body := LGet.Body;
    LEvent := OutboxAmqpEvent(LDelivery, FQueue.Name);
    TAssert.AssertEquals('e1', LEvent.Id);
    TAssert.AssertEquals('appointment.booked', LEvent.Kind);
    TAssert.AssertEquals(TENANT, LEvent.TenantId);
    TAssert.AssertEquals('{"appointmentId":"a1","version":1}', LEvent.Payload);
    TAssert.AssertEquals(Int64(1700000000), LEvent.CreatedAt);
    TAssert.AssertEquals('no try failed yet', 0, LEvent.Attempts);
  finally
    LGet.Properties.Headers.Free;
  end;
  TAssert.AssertEquals('the other kind went nowhere', 0, Integer(Ready(FChannel, FQueue.Name)));
end;

procedure TOutboxTests.Consumer_HandlesOnce_ThenRecorded;
var
  LSink: IOutboxSink;
  LHandler: TTestHandler;
  LKeep: IOutboxHandler;
  LConsume: TAMQPChannel;
  LConsumer: TOutboxAmqpConsumer;
  LDone: Double;
begin
  LDone := MetricValue('outbox.consumer.messages', ['email', 'appointment.booked', 'done']);
  LSink := TOutboxAmqpSink.Create(FChannel, EXCHANGE);
  LHandler := TTestHandler.Create('appointment.booked');
  LKeep := LHandler;
  LConsume := FConnection.CreateChannel;
  LConsumer := TOutboxAmqpConsumer.Create(FDb.Factory, LConsume, FQueue, 'email', LKeep);
  try
    LConsumer.Start;
    LSink.Deliver(nil, Event('e1', 'appointment.booked'), 1700000001);
    LSink.Deliver(nil, Event('e2', 'appointment.booked'), 1700000001);
    TAssert.AssertTrue('both handled', WaitFor(LHandler.Handled, 2));
    TAssert.AssertTrue('acked', WaitReady(FChannel, FQueue.Name, 0));
    LConsumer.Stop;
  finally
    LConsume.Free;
    LConsumer.Free;
  end;
  TAssert.AssertEquals('ran once each', 2, PcAtomicGet(LHandler.Tries));
  TAssert.AssertEquals('recorded', 2, FDb.Count('PROCESSED_EVENTS WHERE CONSUMER = ''email'' ' +
    'AND TENANT_ID = ''demo'''));
  TAssert.AssertEquals('counted done', LDone + 2,
    MetricValue('outbox.consumer.messages', ['email', 'appointment.booked', 'done']), 0);
end;

procedure TOutboxTests.Consumer_Redelivered_NotRunAgain;
var
  LSink: IOutboxSink;
  LHandler: TTestHandler;
  LKeep: IOutboxHandler;
  LConsume: TAMQPChannel;
  LConsumer: TOutboxAmqpConsumer;
  LDuplicate: Double;
begin
  LSink := TOutboxAmqpSink.Create(FChannel, EXCHANGE);
  LHandler := TTestHandler.Create('appointment.booked');
  LKeep := LHandler;
  LConsume := FConnection.CreateChannel;
  LConsumer := TOutboxAmqpConsumer.Create(FDb.Factory, LConsume, FQueue, 'email', LKeep);
  try
    LConsumer.Start;
    LSink.Deliver(nil, Event('e1', 'appointment.booked'), 1700000001);
    TAssert.AssertTrue(WaitFor(LHandler.Handled, 1));
    LDuplicate := MetricValue('outbox.consumer.messages', ['email', 'appointment.booked', 'duplicate']);
    // The same event again (the relay's lease ran out after the publish, a
    // broker's redelivery): acked, not run.
    LSink.Deliver(nil, Event('e1', 'appointment.booked'), 1700000002);
    TAssert.AssertTrue('acked', WaitReady(FChannel, FQueue.Name, 0));
    LConsumer.Stop;
  finally
    LConsume.Free;
    LConsumer.Free;
  end;
  TAssert.AssertEquals('handled once', 1, PcAtomicGet(LHandler.Tries));
  TAssert.AssertEquals(1, FDb.Count('PROCESSED_EVENTS'));
  TAssert.AssertEquals('counted duplicate', LDuplicate + 1,
    MetricValue('outbox.consumer.messages', ['email', 'appointment.booked', 'duplicate']), 0);
end;

procedure TOutboxTests.Consumer_FailsOnce_RetriedFromTheRetryQueue;
var
  LSink: IOutboxSink;
  LHandler: TTestHandler;
  LKeep: IOutboxHandler;
  LConsume: TAMQPChannel;
  LConsumer: TOutboxAmqpConsumer;
  LRetried: Double;
begin
  LSink := TOutboxAmqpSink.Create(FChannel, EXCHANGE);
  LRetried := MetricValue('outbox.consumer.messages', ['email', 'appointment.booked', 'retried']);
  LHandler := TTestHandler.Create('appointment.booked', 1);
  LKeep := LHandler;
  LConsume := FConnection.CreateChannel;
  LConsumer := TOutboxAmqpConsumer.Create(FDb.Factory, LConsume, FQueue, 'email', LKeep);
  try
    LConsumer.OnError := CountError;
    LConsumer.Start;
    LSink.Deliver(nil, Event('e1', 'appointment.booked'), 1700000001);
    TAssert.AssertTrue('handled on the second try', WaitFor(LHandler.Handled, 1));
    TAssert.AssertTrue(WaitReady(FChannel, FQueue.Name, 0));
    LConsumer.Stop;
  finally
    LConsume.Free;
    LConsumer.Free;
  end;
  TAssert.AssertEquals('two tries', 2, PcAtomicGet(LHandler.Tries));
  TAssert.AssertEquals('one error reported', 1, PcAtomicGet(FErrors));
  TAssert.AssertEquals('nothing parked', 0, Integer(Ready(FChannel, FQueue.DeadName)));
  TAssert.AssertEquals(1, FDb.Count('PROCESSED_EVENTS'));
  TAssert.AssertEquals('counted retried', LRetried + 1,
    MetricValue('outbox.consumer.messages', ['email', 'appointment.booked', 'retried']), 0);
end;

procedure TOutboxTests.Consumer_FailsAlways_ParkedAfterTheTries;
var
  LSink: IOutboxSink;
  LHandler: TTestHandler;
  LKeep: IOutboxHandler;
  LConsume: TAMQPChannel;
  LConsumer: TOutboxAmqpConsumer;
  LParked: Double;
begin
  LSink := TOutboxAmqpSink.Create(FChannel, EXCHANGE);
  LParked := MetricValue('outbox.consumer.messages', ['email', 'appointment.booked', 'parked']);
  LHandler := TTestHandler.Create('appointment.booked', -1);
  LKeep := LHandler;
  LConsume := FConnection.CreateChannel;
  LConsumer := TOutboxAmqpConsumer.Create(FDb.Factory, LConsume, FQueue, 'email', LKeep);
  try
    LConsumer.OnError := CountError;
    LConsumer.Start;
    LSink.Deliver(nil, Event('e1', 'appointment.booked'), 1700000001);
    TAssert.AssertTrue('parked', WaitReady(FChannel, FQueue.DeadName, 1));
    LConsumer.Stop;
  finally
    LConsume.Free;
    LConsumer.Free;
  end;
  TAssert.AssertEquals('MaxAttempts tries', 3, PcAtomicGet(LHandler.Tries));
  TAssert.AssertEquals(3, PcAtomicGet(FErrors));
  TAssert.AssertEquals('the work queue empty', 0, Integer(Ready(FChannel, FQueue.Name)));
  TAssert.AssertEquals('the retry queue empty', 0, Integer(Ready(FChannel, FQueue.RetryName)));
  TAssert.AssertEquals('not recorded', 0, FDb.Count('PROCESSED_EVENTS'));
  TAssert.AssertEquals('counted parked', LParked + 1,
    MetricValue('outbox.consumer.messages', ['email', 'appointment.booked', 'parked']), 0);
end;

procedure TOutboxTests.Consumer_OtherKind_AckedNotRun;
var
  LSink: IOutboxSink;
  LHandler: TTestHandler;
  LKeep: IOutboxHandler;
  LConsume: TAMQPChannel;
  LConsumer: TOutboxAmqpConsumer;
  LIgnored: Double;
begin
  LSink := TOutboxAmqpSink.Create(FChannel, EXCHANGE);
  LHandler := TTestHandler.Create('appointment.booked');
  LKeep := LHandler;
  LConsume := FConnection.CreateChannel;
  LConsumer := TOutboxAmqpConsumer.Create(FDb.Factory, LConsume, FQueue, 'email', LKeep);
  try
    LConsumer.Start;
    LIgnored := MetricValue('outbox.consumer.messages', ['email', 'other', 'ignored']);
    // Under the binding key, not a kind the handler takes.
    LSink.Deliver(nil, Event('e1', 'appointment.confirmed'), 1700000001);
    LSink.Deliver(nil, Event('e2', 'appointment.booked'), 1700000001);
    TAssert.AssertTrue(WaitFor(LHandler.Handled, 1));
    TAssert.AssertTrue('both acked', WaitReady(FChannel, FQueue.Name, 0));
    LConsumer.Stop;
  finally
    LConsume.Free;
    LConsumer.Free;
  end;
  TAssert.AssertEquals('the other kind not run', 1, PcAtomicGet(LHandler.Tries));
  TAssert.AssertEquals('counted ignored, as "other"', LIgnored + 1,
    MetricValue('outbox.consumer.messages', ['email', 'other', 'ignored']), 0);
end;

procedure TOutboxTests.PurgeProcessed_ByAge;
begin
  FDb.Exec('INSERT INTO PROCESSED_EVENTS (CONSUMER, TENANT_ID, EVENT_ID, PROCESSED_AT) ' +
    'VALUES (''email'', ''demo'', ''old'', 100)');
  FDb.Exec('INSERT INTO PROCESSED_EVENTS (CONSUMER, TENANT_ID, EVENT_ID, PROCESSED_AT) ' +
    'VALUES (''email'', ''demo'', ''new'', 200)');
  TAssert.AssertEquals(1, OutboxAmqpPurgeProcessed(FDb.Factory, 150));
  TAssert.AssertEquals(1, FDb.Count('PROCESSED_EVENTS WHERE EVENT_ID = ''new'''));
end;

procedure TOutboxTests.Consumer_RecordsTheTimeOfTClock;
var
  LSink: IOutboxSink;
  LHandler: TTestHandler;
  LKeep: IOutboxHandler;
  LConsume: TAMQPChannel;
  LConsumer: TOutboxAmqpConsumer;
begin
  // Set before the consumer's threads exist: TClock is swapped only while
  // nobody reads it (PascalCommon.SystemContext).
  TClock.SetClock(TFixedClock.Create(UnixToDateTime(1700000500, False)));
  try
    LSink := TOutboxAmqpSink.Create(FChannel, EXCHANGE);
    LHandler := TTestHandler.Create('appointment.booked');
    LKeep := LHandler;
    LConsume := FConnection.CreateChannel;
    LConsumer := TOutboxAmqpConsumer.Create(FDb.Factory, LConsume, FQueue, 'email', LKeep);
    try
      LConsumer.Start;
      LSink.Deliver(nil, Event('e1', 'appointment.booked'), 1700000001);
      TAssert.AssertTrue('handled', WaitFor(LHandler.Handled, 1));
      TAssert.AssertTrue('acked', WaitReady(FChannel, FQueue.Name, 0));
      LConsumer.Stop;
    finally
      LConsume.Free;
      LConsumer.Free;
    end;
  finally
    TClock.Reset;
  end;
  TAssert.AssertEquals('PROCESSED_AT is TClock in Unix seconds, UTC', Int64(1700000500),
    FDb.Int64Of('PROCESSED_AT', 'PROCESSED_EVENTS WHERE EVENT_ID = ''e1'''));
end;

initialization
  TDUnitX.RegisterTestFixture(TOutboxTests);

end.
