unit AMQP.ConsumerErrorIntegrationTests;

{ Exception in the consumer callback (v0.4.0) — needs a broker (RabbitMQ or
  the embedded one, through the acceptance suite).

  Up to v0.3.0 the exception was re-raised into the pool, which swallowed it:
  the delivery stayed unacked until the connection dropped, nothing was
  logged, and with Qos(1) the whole consumer stopped (measured against
  RabbitMQ 3: 4 ready and 1 unacked, forever). Now it goes to
  TAMQPChannel.OnConsumerError and, if the delivery is still pending, gets a
  Nack (without requeue, by default).

  Almost every test uses Qos(1) with the bad message IN FRONT of good ones: if
  the library leaves the bad one unacknowledged, the good ones never arrive;
  if it acknowledges twice, the broker closes the channel with 406 and the
  good ones do not arrive either. The main queue dead-letters to amq.direct,
  where the DLQ waits on the main queue's key: that is how the Nack without
  requeue is seen.

  DUnitX master in the FPCUnit dialect (TAssert.*); the FPCUnit mirror in
  fpc\ is generated by tools/gen_fpc_mirror.py. }


interface

uses
  DUnitX.TestFramework,
  AMQP.DUnitXCompat,
  SysUtils, Classes, SyncObjs, Rtti,
  PascalCommon.Threading,
  AMQP.Wire,
  AMQP.Basic.Methods,
  AMQP.Connection,
  AMQP.IntegrationConfig,
  AMQP.Queue.Methods;

type
  [TestFixture]
  TAMQPConsumerErrorIntegrationTests = class
  private
    FConn: TAMQPConnection;
    FChan: TAMQPChannel;
    FReconConn: TAMQPConnection;
    FQueue: string;
    FDlq: string;
    // what the callback does with the 'bad' (bad) message (MODO_*) and the handler (H_*)
    FMode: Integer;
    FHandlerMode: Integer;
    FNoAck: Boolean;
    // atomic counters
    FCalls: Integer;      // callbacks called
    FAcks: Integer;       // good messages acked by the callback
    FErrors: Integer;     // OnConsumerError calls that finished
    FRedeliveredOk: Integer; // the bad one, redelivered, acked (MODE_REQUEUE)
    FReconnected: Integer;
    // what the handler saw (written before FErrors goes up)
    FInitialAction: Integer;
    FErrorClass: string;
    FErrorMessage: string;
    FErrorBody: string;
    FPendingTag: UInt64;
    // MODE_RECONNECT: the old session's delivery holds until the drop
    FOldStarted: TEvent;
    FReleaseOld: TEvent;
    procedure HandleDelivery(AChannel: TAMQPChannel; const ADelivery: TAMQPDelivery);
    procedure HandleError(AChannel: TAMQPChannel; const ADelivery: TAMQPDelivery;
      AError: Exception; var AAction: TAMQPConsumerErrorAction);
    procedure HandleReconnect(AConnection: TAMQPConnection);
    function WaitForCount(var ACounter: Integer; AValue, ATimeoutMs: Integer): Boolean;
    /// Main queue dead-lettering to amq.direct + DLQ bound by the main queue's
    /// key. With an empty AName both are exclusive and have generated names.
    procedure DeclareQueues(AChannel: TAMQPChannel; const AName: string);
    function ReadDlq(AChannel: TAMQPChannel; ATimeoutMs: Integer): string;
    procedure PublishBadAndGood(AGoodCount: Integer);
  public
    [Setup] procedure SetUp;
    [TearDown] procedure TearDown;
    [Test] procedure NoHandler_CallbackRaises_NackWithoutRequeue_And_DoesNotHang;
    [Test] procedure Handler_ReceivesExceptionDelivery_And_InitialActionReject;
    [Test] procedure Handler_Requeue_RedeliversWithRedelivered;
    [Test] procedure Handler_None_DeliveryStaysWithTheApplication;
    [Test] procedure CallbackAckedBeforeRaising_DoesNotConfirmAgain;
    [Test] procedure HandlerAckedItself_DoesNotConfirmAgain;
    [Test] procedure HandlerRaises_ActionStillApplies;
    [Test] procedure NoAck_CallbackRaises_HandlerCalled_NoNack;
    [Test] procedure Reconnect_CallbackRaisesOnDrop_MessageReturnsInNewSession;
  end;

implementation

const
  MODE_RAISE = 0;       // raises right away
  MODE_ACK_AND_RAISE = 1; // acks and then raises
  MODE_REQUEUE = 2;       // raises; once redelivered, acks
  MODE_RECONNECT = 3;     // see Reconnect_CallbackRaisesOnDrop_MessageReturnsInNewSession

  H_DEFAULT = 0;           // leaves the action alone
  H_REQUEUE = 1;
  H_NONE = 2;             // ceaNone + keeps the tag for the test to ack
  H_ACK_ITSELF = 3;    // acks in the handler itself and leaves the default action
  H_RAISE = 4;          // raises inside the handler

  TIMEOUT_MS = 10000;

// Assertions with a fixed type: the value comes in already converted, and the
// TAssert overload is the same on both compilers.
procedure CheckInt(const AMsg: string; AExpected, AActual: Integer);
begin
  TAssert.AssertEquals(AMsg, AExpected, AActual);
end;

procedure CheckStr(const AMsg: string; const AExpected, AActual: string);
begin
  TAssert.AssertEquals(AMsg, AExpected, AActual);
end;

procedure CheckOk(const AMsg: string; ACond: Boolean);
begin
  TAssert.AssertTrue(AMsg, ACond);
end;

procedure TAMQPConsumerErrorIntegrationTests.SetUp;
begin
  FConn := TAMQPConnection.Create(IntegrationParams);
  FConn.Open;
  FChan := FConn.CreateChannel;
  FReconConn := nil;
  FMode := MODE_RAISE;
  FHandlerMode := H_DEFAULT;
  FNoAck := False;
  FCalls := 0;
  FAcks := 0;
  FErrors := 0;
  FRedeliveredOk := 0;
  FReconnected := 0;
  FInitialAction := -1;
  FPendingTag := 0;
  FOldStarted := TEvent.Create(nil, True, False, '');
  FReleaseOld := TEvent.Create(nil, True, False, '');
end;

procedure TAMQPConsumerErrorIntegrationTests.TearDown;
begin
  // Releases a callback stuck from a test that failed midway, otherwise Free waits.
  FReleaseOld.SetEvent;
  FChan.Free;
  FConn.Free;
  FReconConn.Free; // nil-safe
  FOldStarted.Free;
  FReleaseOld.Free;
end;

procedure TAMQPConsumerErrorIntegrationTests.HandleDelivery(AChannel: TAMQPChannel;
  const ADelivery: TAMQPDelivery);
begin
  PcAtomicInc(FCalls);
  if ADelivery.BodyAsText <> 'bad' then
  begin
    if not FNoAck then
      AChannel.Ack(ADelivery.DeliveryTag);
    PcAtomicInc(FAcks);
    Exit;
  end;

  case FMode of
    MODE_ACK_AND_RAISE:
      AChannel.Ack(ADelivery.DeliveryTag);
    MODE_REQUEUE:
      if ADelivery.Redelivered then
      begin
        AChannel.Ack(ADelivery.DeliveryTag);
        PcAtomicInc(FRedeliveredOk);
        Exit;
      end;
    MODE_RECONNECT:
      if ADelivery.Redelivered then
      begin
        // redelivery in the new session: process normally
        AChannel.Ack(ADelivery.DeliveryTag);
        PcAtomicInc(FRedeliveredOk);
        Exit;
      end
      else
      begin
        // delivery from the old session: hold until the drop and raise afterwards
        FOldStarted.SetEvent;
        FReleaseOld.WaitFor(TIMEOUT_MS);
      end;
  end;
  raise EConvertError.Create('"quantity":"x" is not a valid integer');
end;

procedure TAMQPConsumerErrorIntegrationTests.HandleError(AChannel: TAMQPChannel;
  const ADelivery: TAMQPDelivery; AError: Exception;
  var AAction: TAMQPConsumerErrorAction);
begin
  FInitialAction := Ord(AAction);
  FErrorClass := AError.ClassName;
  FErrorMessage := AError.Message;
  FErrorBody := ADelivery.BodyAsText;
  case FHandlerMode of
    H_REQUEUE:
      if not ADelivery.Redelivered then
        AAction := ceaRequeue;
    H_NONE:
      begin
        FPendingTag := ADelivery.DeliveryTag;
        AAction := ceaNone;
      end;
    H_ACK_ITSELF:
      AChannel.Ack(ADelivery.DeliveryTag);
    H_RAISE:
      begin
        PcAtomicInc(FErrors);
        raise Exception.Create('the error handler broke too');
      end;
  end;
  PcAtomicInc(FErrors);
end;

procedure TAMQPConsumerErrorIntegrationTests.HandleReconnect(AConnection: TAMQPConnection);
begin
  PcAtomicSet(FReconnected, 1);
end;

function TAMQPConsumerErrorIntegrationTests.WaitForCount(var ACounter: Integer;
  AValue, ATimeoutMs: Integer): Boolean;
var
  LWaited: Integer;
begin
  LWaited := 0;
  while (PcAtomicGet(ACounter) < AValue) and (LWaited < ATimeoutMs) do
  begin
    TThread.Sleep(20);
    Inc(LWaited, 20);
  end;
  Result := PcAtomicGet(ACounter) >= AValue;
end;

procedure TAMQPConsumerErrorIntegrationTests.DeclareQueues(AChannel: TAMQPChannel;
  const AName: string);
var
  LArgs: TAMQPFieldTable;
  LVal: TValue;
  LDecl: TAMQPQueueDeclare;
  LBind: TAMQPQueueBind;
begin
  LArgs := TAMQPFieldTable.Create;
  try
    LVal := TValue.From<string>('amq.direct');
    LArgs.Put('x-dead-letter-exchange', LVal);
    LDecl := Default(TAMQPQueueDeclare);
    LDecl.QueueName := AName;
    LDecl.Exclusive := AName = '';
    LDecl.Arguments := LArgs;
    FQueue := AChannel.DeclareQueue(LDecl).QueueName;
  finally
    LArgs.Free;
  end;

  LDecl := Default(TAMQPQueueDeclare);
  if AName <> '' then
    LDecl.QueueName := AName + '-dlq';
  LDecl.Exclusive := AName = '';
  FDlq := AChannel.DeclareQueue(LDecl).QueueName;

  // the dead-lettered message keeps the original key: the main queue's name
  LBind := Default(TAMQPQueueBind);
  LBind.QueueName := FDlq;
  LBind.ExchangeName := 'amq.direct';
  LBind.RoutingKey := FQueue;
  AChannel.BindQueue(LBind);
end;

function TAMQPConsumerErrorIntegrationTests.ReadDlq(AChannel: TAMQPChannel;
  ATimeoutMs: Integer): string;
var
  LGet: TAMQPGetResult;
  LWaited: Integer;
begin
  Result := '';
  LWaited := 0;
  repeat
    LGet := AChannel.BasicGet(FDlq, True);
    if LGet.Found then
    begin
      if LGet.Properties.Has(bpHeaders) and Assigned(LGet.Properties.Headers) then
        LGet.Properties.Headers.Free; // x-death
      Exit(LGet.BodyAsText);
    end;
    if LWaited >= ATimeoutMs then
      Exit;
    TThread.Sleep(50);
    Inc(LWaited, 50);
  until False;
end;

procedure TAMQPConsumerErrorIntegrationTests.PublishBadAndGood(AGoodCount: Integer);
var
  I: Integer;
begin
  FChan.PublishText('', FQueue, 'bad');
  for I := 1 to AGoodCount do
    FChan.PublishText('', FQueue, 'good-' + IntToStr(I));
end;

procedure TAMQPConsumerErrorIntegrationTests.NoHandler_CallbackRaises_NackWithoutRequeue_And_DoesNotHang;
begin
  // The measured scenario: with no try in the callback and with Qos(1), the
  // bad one held up the whole consumer. Without a handler, it goes to the DLQ
  // and the good ones get through.
  DeclareQueues(FChan, '');
  PublishBadAndGood(3);
  FChan.Qos(1);
  FChan.Consume(FQueue, HandleDelivery);

  CheckOk('the 3 good ones should pass after the bad one (Qos 1)', WaitForCount(FAcks, 3, TIMEOUT_MS));
  CheckStr('the bad one should have gone to the DLQ (Nack without requeue)', 'bad', ReadDlq(FChan, TIMEOUT_MS));
  CheckInt('the bad one should not have been redelivered', 4, PcAtomicGet(FCalls));
  CheckOk('the channel should stay open', FChan.IsOpen);
end;

procedure TAMQPConsumerErrorIntegrationTests.Handler_ReceivesExceptionDelivery_And_InitialActionReject;
begin
  DeclareQueues(FChan, '');
  FChan.OnConsumerError := HandleError;
  PublishBadAndGood(1);
  FChan.Qos(1);
  FChan.Consume(FQueue, HandleDelivery);

  CheckOk('the handler should have been called', WaitForCount(FErrors, 1, TIMEOUT_MS));
  CheckStr('exception class', 'EConvertError', FErrorClass);
  CheckStr('exception message', '"quantity":"x" is not a valid integer', FErrorMessage);
  CheckStr('the delivery that raised', 'bad', FErrorBody);
  CheckInt('pending delivery: the initial action is ceaReject', Ord(ceaReject), FInitialAction);
  CheckOk('the good one should pass', WaitForCount(FAcks, 1, TIMEOUT_MS));
  CheckStr('action kept: the bad one goes to the DLQ', 'bad', ReadDlq(FChan, TIMEOUT_MS));
end;

procedure TAMQPConsumerErrorIntegrationTests.Handler_Requeue_RedeliversWithRedelivered;
begin
  FMode := MODE_REQUEUE;
  FHandlerMode := H_REQUEUE;
  DeclareQueues(FChan, '');
  FChan.OnConsumerError := HandleError;
  PublishBadAndGood(2);
  FChan.Qos(1);
  FChan.Consume(FQueue, HandleDelivery);

  CheckOk('the bad one should come back (redelivered) and be acked', WaitForCount(FRedeliveredOk, 1, TIMEOUT_MS));
  CheckOk('the good ones should pass', WaitForCount(FAcks, 2, TIMEOUT_MS));
  CheckInt('the handler runs only on the first delivery', 1, PcAtomicGet(FErrors));
  CheckStr('with requeue the DLQ stays empty', '', ReadDlq(FChan, 300));
  CheckOk('the channel should stay open', FChan.IsOpen);
end;

procedure TAMQPConsumerErrorIntegrationTests.Handler_None_DeliveryStaysWithTheApplication;
begin
  FHandlerMode := H_NONE;
  DeclareQueues(FChan, '');
  FChan.OnConsumerError := HandleError;
  PublishBadAndGood(2);
  FChan.Qos(1);
  FChan.Consume(FQueue, HandleDelivery);

  CheckOk('the handler should have been called', WaitForCount(FErrors, 1, TIMEOUT_MS));
  // ceaNone: the library does not ack, so with Qos(1) nothing else arrives...
  TThread.Sleep(300);
  CheckInt('with the bad one pending, no good one should arrive', 0, PcAtomicGet(FAcks));
  // ...until the application acks on its own.
  FChan.Nack(FPendingTag, False);
  CheckOk('acked by the application, the good ones pass', WaitForCount(FAcks, 2, TIMEOUT_MS));
  CheckStr('the application''s Nack sent the bad one to the DLQ', 'bad', ReadDlq(FChan, TIMEOUT_MS));
end;

procedure TAMQPConsumerErrorIntegrationTests.CallbackAckedBeforeRaising_DoesNotConfirmAgain;
begin
  // Acknowledging the same tag twice is 406 PRECONDITION_FAILED: the broker
  // closes the channel and the good ones never arrive.
  FMode := MODE_ACK_AND_RAISE;
  DeclareQueues(FChan, '');
  FChan.OnConsumerError := HandleError;
  PublishBadAndGood(2);
  FChan.Qos(1);
  FChan.Consume(FQueue, HandleDelivery);

  CheckOk('the handler should have been called', WaitForCount(FErrors, 1, TIMEOUT_MS));
  CheckInt('already acked: the initial action is ceaNone', Ord(ceaNone), FInitialAction);
  CheckOk('the good ones should pass (no 406)', WaitForCount(FAcks, 2, TIMEOUT_MS));
  CheckOk('the channel should stay open', FChan.IsOpen);
  CheckStr('the bad one was acked: the DLQ stays empty', '', ReadDlq(FChan, 300));
end;

procedure TAMQPConsumerErrorIntegrationTests.HandlerAckedItself_DoesNotConfirmAgain;
begin
  // The handler acks and leaves the action at ceaReject: the library checks
  // again after the handler and does not send the Nack.
  FHandlerMode := H_ACK_ITSELF;
  DeclareQueues(FChan, '');
  FChan.OnConsumerError := HandleError;
  PublishBadAndGood(2);
  FChan.Qos(1);
  FChan.Consume(FQueue, HandleDelivery);

  CheckOk('the handler should have been called', WaitForCount(FErrors, 1, TIMEOUT_MS));
  CheckInt('the initial action was ceaReject', Ord(ceaReject), FInitialAction);
  CheckOk('the good ones should pass (no 406)', WaitForCount(FAcks, 2, TIMEOUT_MS));
  CheckOk('the channel should stay open', FChan.IsOpen);
  CheckStr('the handler''s Ack won: the DLQ stays empty', '', ReadDlq(FChan, 300));
end;

procedure TAMQPConsumerErrorIntegrationTests.HandlerRaises_ActionStillApplies;
begin
  FHandlerMode := H_RAISE;
  DeclareQueues(FChan, '');
  FChan.OnConsumerError := HandleError;
  PublishBadAndGood(2);
  FChan.Qos(1);
  FChan.Consume(FQueue, HandleDelivery);

  CheckOk('the good ones should pass even with the handler broken', WaitForCount(FAcks, 2, TIMEOUT_MS));
  CheckStr('the default action still applied', 'bad', ReadDlq(FChan, TIMEOUT_MS));
end;

procedure TAMQPConsumerErrorIntegrationTests.NoAck_CallbackRaises_HandlerCalled_NoNack;
begin
  // On a no-ack consumer there is nothing to acknowledge: a Nack would be 406
  // (unknown tag) and would close the channel.
  FNoAck := True;
  DeclareQueues(FChan, '');
  FChan.OnConsumerError := HandleError;
  PublishBadAndGood(2);
  FChan.Consume(FQueue, HandleDelivery, True);

  CheckOk('the handler should be called on no-ack too', WaitForCount(FErrors, 1, TIMEOUT_MS));
  CheckInt('no-ack: the initial action is ceaNone', Ord(ceaNone), FInitialAction);
  CheckOk('the good ones should arrive', WaitForCount(FAcks, 2, TIMEOUT_MS));
  // a 406 arrives asynchronously: give it time before looking at the channel
  CheckStr('no-ack: nothing goes to the DLQ', '', ReadDlq(FChan, 300));
  CheckOk('the channel should stay open', FChan.IsOpen);
end;

procedure TAMQPConsumerErrorIntegrationTests.Reconnect_CallbackRaisesOnDrop_MessageReturnsInNewSession;
var
  LParams: TAMQPConnectionParams;
  LChan: TAMQPChannel;
  LDel: TAMQPQueueDelete;
  LName: string;
begin
  // The callback raises AFTER the connection drops. The reconnection waits
  // for the old session's callbacks to finish before reopening the channel
  // (DrainAllChannels), so the automatic Nack lands on the dead socket and is
  // silently dropped: the broker has already returned the message to the
  // queue, and it comes back with Redelivered=True in the new session. If the
  // Nack reached the broker, the message would go to the DLQ and never be
  // redelivered.
  FMode := MODE_RECONNECT;
  LName := 'test-consumer-err-' + IntToStr(PcTickMs);
  LParams := IntegrationParams;
  LParams.AutoReconnect := True;
  LParams.ReconnectDelayMs := 200;
  FReconConn := TAMQPConnection.Create(LParams);
  FReconConn.OnReconnect := HandleReconnect;
  FReconConn.Open;
  LChan := FReconConn.CreateChannel;
  try
    LChan.OnConsumerError := HandleError;
    DeclareQueues(LChan, LName); // named and non-exclusive: they survive the drop
    try
      LChan.PublishText('', FQueue, 'bad');
      LChan.Consume(FQueue, HandleDelivery);
      CheckOk('the old delivery should start', FOldStarted.WaitFor(TIMEOUT_MS) = wrSignaled);

      FReconConn.DropConnectionForTest;
      FReleaseOld.SetEvent; // the old one raises now, with the socket already closed
      CheckOk('the handler should have been called', WaitForCount(FErrors, 1, TIMEOUT_MS));
      CheckInt('the delivery was still pending: ceaReject', Ord(ceaReject), FInitialAction);

      CheckOk('should reconnect', WaitForCount(FReconnected, 1, TIMEOUT_MS));
      CheckOk('the message should come back in the new session and be acked',
        WaitForCount(FRedeliveredOk, 1, TIMEOUT_MS));
      LChan.PublishText('', FQueue, 'after');
      CheckOk('the channel should keep consuming', WaitForCount(FAcks, 1, TIMEOUT_MS));
      CheckStr('the Nack on the dead socket did not reach the broker', '', ReadDlq(LChan, 300));
    finally
      LDel := Default(TAMQPQueueDelete);
      LDel.QueueName := FQueue;
      try LChan.DeleteQueue(LDel); except end;
      LDel.QueueName := FDlq;
      try LChan.DeleteQueue(LDel); except end;
    end;
  finally
    LChan.Free;
  end;
end;

initialization
  TDUnitX.RegisterTestFixture(TAMQPConsumerErrorIntegrationTests);

end.
