unit AMQP.TestSupport;

{ What the tests need and the kit's TAssert (AMQP.DUnitXCompat on the
  Delphi side; fpcunit.TAssert on the FPC side) does not have. The DUnitX masters
  are written in FPCUnit's dialect and the FPC mirror is generated by
  tools/gen_fpc_mirror.py, which rejects any DUnitX API in the body. What
  really differs between the compilers lives here, in a single file that both
  runners compile: this unit is not generated (the generator only reads *Tests.pas).

  - CheckRaises: FPCUnit's AssertException. Requires the EXACT class (like
    it, and unlike DUnitX's Assert.WillRaise, which accepts a subclass).
  - IgnoreTest: FPCUnit's Ignore (marks IGNORED). This version's DUnitX
    has no run-time ignore: the test leaves through Assert.Pass with
    the message 'IGNORED: ...' and counts as Passed. The caller exits with Exit
    right after, in case neither of the two interrupts.
  - TempDir: Delphi has no GetTempDir; FPC has no System.IOUtils.
  - Pki: the TLS test PKI, pascal-common-faa's tests/pki through the
    submodule (CA, server, legitimate and rogue clients; README there). Not
    a compiler difference, but every runner needs it, server and acceptance
    alike. }

{$IFDEF FPC}{$MODE DELPHI}{$H+}{$ENDIF}

interface

uses
  SysUtils;

type
  TRaisingMethod = procedure of object;

procedure CheckRaises(AClass: ExceptClass; AMethod: TRaisingMethod); overload;
procedure CheckRaises(const AMessage: string; AClass: ExceptClass;
  AMethod: TRaisingMethod); overload;
procedure IgnoreTest(const AReason: string);
function TempDir: string;
/// Full path of a file in the test PKI (external/pascal-common-faa/tests/pki,
/// looked for upwards from the executable). Raises if it isn't there.
function Pki(const AName: string): string;
/// Password of every PFX in the test PKI.
const
  PKI_PFX_PASSWORD = 'pipestest';

implementation

uses
{$IFDEF FPC}
  fpcunit;
{$ELSE}
  IOUtils,
  DUnitX.TestFramework,
  AMQP.DUnitXCompat;
{$ENDIF}

procedure CheckRaises(const AMessage: string; AClass: ExceptClass;
  AMethod: TRaisingMethod);
var
  LRaised: Boolean;
  LClassName: string;
begin
  LRaised := False;
  LClassName := '';
  try
    AMethod;
  except
    on E: Exception do
    begin
      LRaised := True;
      LClassName := E.ClassName;
    end;
  end;
  TAssert.AssertTrue(Trim(AMessage + ' expected ' + AClass.ClassName +
    ', and nothing was raised'), LRaised);
  TAssert.AssertEquals(Trim(AMessage + ' exception class'), AClass.ClassName,
    LClassName);
end;

procedure CheckRaises(AClass: ExceptClass; AMethod: TRaisingMethod);
begin
  CheckRaises('', AClass, AMethod);
end;

procedure IgnoreTest(const AReason: string);
begin
{$IFDEF FPC}
  raise EIgnoredTest.Create(AReason);
{$ELSE}
  Assert.Pass('IGNORED: ' + AReason);
{$ENDIF}
end;

function TempDir: string;
begin
{$IFDEF FPC}
  Result := GetTempDir;
{$ELSE}
  Result := TPath.GetTempPath;
{$ENDIF}
end;

var
  GPkiDir: string;

function Pki(const AName: string): string;
var
  LDir, LTry: string;
  I: Integer;
begin
  if GPkiDir = '' then
  begin
    LDir := ExtractFileDir(ExpandFileName(ParamStr(0)));
    for I := 0 to 8 do
    begin
      LTry := IncludeTrailingPathDelimiter(LDir) + 'external' + PathDelim +
        'pascal-common-faa' + PathDelim + 'tests' + PathDelim + 'pki';
      if FileExists(LTry + PathDelim + 'ca_cert.pem') then
      begin
        GPkiDir := LTry;
        Break;
      end;
      LDir := ExtractFileDir(LDir);
    end;
    if GPkiDir = '' then
      raise Exception.Create(
        'external/pascal-common-faa/tests/pki not found above ' + ParamStr(0));
  end;
  Result := IncludeTrailingPathDelimiter(GPkiDir) + AName;
end;

end.
